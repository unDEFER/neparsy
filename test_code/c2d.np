(c2d#module@Neparsy

    (#replace
        (#module@C)
        ($modname#module@D)
    )

    (#replace
        (include#cpreprocessor "stdio.h")
        (#import std.stdio)
    )

    (#remove
        (include#cpreprocessor)
    )

    (#replace
        (printf#funcall)
        (writef#funcall)
    )
)
