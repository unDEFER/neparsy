                    (= (ne#var Expression) (#new (Expression#funcall (~ "(=" (#ord (#? (!#unary (#\. label empty)) (~ "@" label) (#quote :) "")) (#quote ~) " back2 this)") true)))
                    (#\. code (addChild#funcall ne))
