                    (#if (&& (is postop null) (#ord (|| (#\. code arguments (#quote \.) empty) (!= (#\. code arguments (#[ (- $ 1)) (#quote \.) operator) "||") (#quote ||) (!#unary (#\. code arguments (#[ (- $ 1)) (#quote \.) postop (#quote \.) arguments (#quote \.) empty))))).
