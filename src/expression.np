                                (#case ".")
                                (#if (!#unary (#\. arguments empty)).
                                    (#body
                                        (quoted_op#var bool)
                                        (#\. this arguments (#[ 0) (#quote \.) (saveD#funcall resstr pos (-#unary tab (#quote -) 1) null "op"))
                                        (#foreach i arg (#\. this arguments (#[ 1 \.\. $))).
                                        (#body
                                            (#if (&& (== (#\. arg type) "quote") (== (#\. arg arguments (#[ 0) (#quote \.) operator) (#\. this type))).
                                                (#body
                                                    (savePrint#funcall resstr pos (#\. this type) (#\. arg arguments (#[ 0) (#quote \.) operator_lexem))
