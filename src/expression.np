                            (#\. code (addChild#funcall ne2))
                        )
                        (#quote else if) (&& (!#unary (#\. code arguments (#quote \.) empty)) (== (#\. code arguments (#[ (- $ 1)) (#quote \.) operator) "||") (#quote &&) (#\. code arguments (#[ (- $ 1)) (#quote \.) postop (#quote \.) arguments (#quote \.) empty)).
                        (#body
                            (= (co#var auto) (#\. code arguments (#[ (- $ 1))))
                            (= (#\. ne postop) null)
                            (#\. co (addChild#funcall ne))
                            (#if (!is postop null).
                                (#body
                                    (= code (#\. co postop))
                                    (assert#funcall (!is code null))
                                ))
                        )
                        #else.
                        (#body
                            (#\. code (addChild#funcall ne))
                            (= code (#\. ne postop))
                            (assert#funcall (!is code null))
                        ))
                )
                (#quote else if) (== type "while").
                (#body
                    (ne#var Expression)

                    (= (back#var Expression) (#new (Expression#funcall "(= this back)" true)))

                    (#if (<= (#\. arguments length) 1).
                        (#body
                            (#if (== (#\. arguments (#[ 0) (#quote \.) operator) "!").
                                (#body
                                    (= ne (#new (Expression#funcall (~ "(#do" (#ord (#? (!#unary (#\. label empty)) (~ "@" label) (#quote :) "")) (#quote ~) " !).(#body (= back this) nextChr)") true)))
                                    (#\. code (addChild#funcall ne))
                                    (#\. code (addChild#funcall back))

                                    (= code (#\. ne arguments (#[ 0)))
                                )
                                #else.
                                (#body
                                    (= ne (#new (Expression#funcall "(#do).(#body (= back this) nextChr)" true)))
                                    (#\. code (addChild#funcall ne))
                                    (#\. code (addChild#funcall back))

                                    (= code ne)
                                ))
                        )
                        #else.
                        (#body
                            (= ne (#new (Expression#funcall "(#do ||).(#body (= back this) nextChr)" true)))
                            (#\. code (addChild#funcall ne))
                            (#\. code (addChild#funcall back))

                            (= code (#\. ne arguments (#[ 0)))
                        ))
                )
                (#quote else if) (|| (&& (== (#\. parent type) "while") (!= operator "!")) (&& (#ord (|| (== (#\. parent operator) "||") (== (#\. parent operator) "!"))) (== (#\. parent parent (#quote \.) type) "while"))).
                (#body
                    (ne#var Expression)
                    (#if (#\. operator (startsWith#funcall "is")).
                        (#body
                            (= ne (#new (Expression#funcall (~ "(" operator (#quote ~) " chr)") true)))
                        )
                        (#quote else if) (|| (&& (> (#\. operator length) 2) (== (#\. operator (#[ 0)) '\'') (#quote &&) (== (#\. operator (#[ (- $ 1))) '\'')) (== operator "EOF")).
                        (#body
                            (= ne (#new (Expression#funcall (~ "(== chr " operator (#quote ~) ")") true)))
                        )
                        (#quote else if) (&& (> (#\. operator length) 2) (== (#\. operator (#[ 0)) '"') (#quote &&) (== (#\. operator (#[ (- $ 1))) '"')).
                        (#body
                            (= ne (#new (Expression#funcall (~ "(! (#. " operator (#quote ~) " (find chr) empty))") true)))
                        )
                        (#quote else if) (== type "\"").
                        (#body
                            (= ne (#new (Expression#funcall "(! (#. replace_this (find chr) empty))" true)))
                            (= (dc#var auto) (#\. this deepcopy))
                            (#\. ne arguments (#[ 0) (#quote \.) arguments (#[ 0) (#quote \.) (replace#funcall dc))
                            (= (#\. dc postop) null)
                        )
                        #else.
                        (#body
                            (writefln#funcall "%s#%s" operator type)
                            (assert#funcall 0)
                        ))

                    (#\. code (addChild#funcall ne))
                )
                (#quote else if) (== (#\. parent type) "goto").
                (#body
                    (= (ne#var Expression) (#new (Expression#funcall (~ "(#goto " operator (#quote ~) ")") true)))
                    (#\. code (addChild#funcall ne))
                )
                (#quote else if) (== (#\. parent type) "return").
                (#body
                    (ne#var Expression)

                    (#if main.
                        (#body
                            (= ne (#new (Expression#funcall (~ "(= type (#. LexemType " operator (#quote ~) "))") true)))
                            (#\. code (addChild#funcall ne))
                        ))

                    (= ne (#new (Expression#funcall "(#return)" true)))
                    (#\. code (addChild#funcall ne))
                )
                (#quote else if) (|| (== operator "--") (== operator "++")).
                (#body
                    (#\. code (addChild#funcall this))
                    #return
                ))

            (#foreach . arg arguments).
            (#body
                (#\. arg (toLexer#funcall code main))
            )

            (#if (!is postop null).
                (#body
                    (#\. postop (toLexer#funcall code main))
                ))
        )

        (toLexer#function void (code Expression) (lexer Expression) (lTypes ([]#type bool string) ref)).
        (#body
            (#if (&& (== type "return") (> (#\. arguments length) 0)).
                (#body
                    (= (#\. lTypes (#[ (#\. arguments (#[ 0) (#quote \.) operator))) true)
                ))

            (#if (== type "function").
                (#body
                    (#if (== operator "Start").
                        (#body
                            (= (main#var Expression) (#new Expression#funcall))
                            (#if (!is postop null).
                                (#body
                                    (#\. postop (toLexer#funcall main true))
                                ))

                            (#if (!#unary (#\. main arguments (#quote \.) empty)).
                                (#body
                                    (#\. code (replace#funcall (#\. main arguments (#[ 0))))
                                    (#foreach . arg (#\. main arguments (#[ 1 \.\. $))).
                                    (#body
                                        (#\. code (addAfter#funcall arg))
                                        (= code arg)
                                    )
                                ))
                        )
                        #else.
                        (#body
                            (= (func#var Expression) (#new (Expression#funcall (~ "(" operator (#quote ~) "#function void).(#body (back#var Lexer) (back2#var Lexer))") true)))
                            (#if (!is postop null).
                                (#body
                                    (#\. postop (toLexer#funcall (#\. func postop) false))
                                ))

                            (#\. lexer (addChild#funcall func))
                        ))
                ))

            (#foreach . arg arguments).
            (#body
                (#\. arg (toLexer#funcall code lexer lTypes))
            )

            (#if (!is postop null).
                (#body
                    (#\. postop (toLexer#funcall code lexer lTypes))
                ))
        )

        (toLexer#function Expression).
        (#body
            (. code#var lexemTypes#var lexer#var).(Expression)
            (= (text#var string) (readText#funcall "lexer_templ.np"))
            (= (ret#var Expression) (#new (Expression#funcall text)))
            (#\. ret (findBlocks#funcall code lexemTypes lexer))
            (assert#funcall (!is lexemTypes null))
            (assert#funcall (!is code null))

            (= (#\. ret operator) "lexer_synth.np")
            (= (#\. ret arguments (#[ 0) (#quote \.) operator) "lexer_synth")

            (= (lTypes#var ([]#type bool string)) (#\. (#ord (#\. bool (#[ string))) init))

            (toLexer#funcall code lexer lTypes)

            (#foreach ltype _ lTypes).
            (#body
                (= (ne#var auto) (#new Expression))
                (= (#\. ne operator) ltype)
                (#\. lexemTypes (addChild#funcall ne))
            )

            (#return ret)
        )

        (#attr static).(readFile#function ([]#type char) (filename string)).
        (#body
            (= (file#var auto) (File#funcall filename))
            (mod#var ([]#type char))
            (#foreach . line (#\. file byLine#funcall)).
            (#body
                (= line (strip#funcall line))
                (#if (&& (!#unary (#\. mod empty)) (!= (#\. mod (#[ (- $ 1))) ' ')).
                    (#body
                        (~= mod ' ')
                    ))

                (#if (== line ".").
                    (#body
                        (= line (#\. ". " dup))
                    ))

                (~= mod line)
            )

            (#return mod)
        )

        (deepcopy#function Expression).
        (#body
            (= (copy#var Expression) (#new Expression#funcall))
            (= (#\. copy operator) operator)
            (= (#\. copy type) type)
            (= (#\. copy label) label)
            (= (#\. copy parent) parent)
            (= (#\. copy index) index)
            (= (#\. copy center) center)
            (= (#\. copy hidden) hidden)
            (= (#\. copy level) level)
            (= (#\. copy levels) levels)
            (= (#\. copy bt) bt)

            (= (#\. copy x) x)
            (= (#\. copy y) y)
            (= (#\. copy r1) r1)
            (= (#\. copy r2) r2)
            (= (#\. copy r3) r3)
            (= (#\. copy a1) a1)
            (= (#\. copy a2) a2)

            (#foreach . arg arguments).
            (#body
                (~= (#\. copy arguments) (#\. arg deepcopy#funcall))
                (= (#\. copy arguments (#[ (- $ 1)) (#quote \.) parent) copy)
            )

            (#if (!is postop null).
                (#body
                    (= (#\. copy postop) (#\. postop deepcopy#funcall))
                    (= (#\. copy postop (#quote \.) parent) copy)
                ))

            (#return copy)
        )

        (movecopy#function Expression).
        (#body
            (= (copy#var auto) deepcopy#funcall)

            (#if (>= index 0).
                (#body
                    (++#post (#\. copy index))
                    (#foreach . arg (#\. parent arguments (#[ (+ index 1) \.\. $))).
                    (#body
                        (++#post (#\. arg index))
                    )
                    (= (#\. parent arguments) (~ (#\. parent arguments (#[ 0 \.\. (+ index 1))) copy (#quote ~) (#\. parent arguments (#[ (+ index 1) \.\. $))))
                ))

            (#return copy)
        )

        (#attr override).(toString#function string).
        (#body
            (#return (~ operator (#ord (#? (!#unary (#\. type empty)) (~ "#" type) (#quote :) "")) (#quote ~) (#ord (#? (!#unary (#\. label empty)) (~ "@" label) (#quote :) ""))))
        )
    ))
