                                #break

                                (#case "body")
                                (#case "{")
                                (#if (|| (> (#\. this arguments (#quote \.) length) 1) (> (#\. open_lexem start (#quote \.) row) 0) (#quote ||) (> (#\. type_lexem start (#quote \.) row) 0)).
                                    (#body (savePrint#funcall resstr pos "{" (#? (> (#\. open_lexem start (#quote \.) row) 0) open_lexem (#quote :) type_lexem))))
                                (#foreach i arg (#\. this arguments)).
                                (#body
                                    (#\. arg (saveD#funcall resstr pos (+ tab 1) (getPost#funcall i) (#\. this type)))
                                )
                                (#if (|| (> (#\. this arguments (#quote \.) length) 1) (> (#\. close_lexem start (#quote \.) row) 0)).
