                                #break

                                (#case "return")
                                (#case "break")
                                (#case "continue")
                                (#case "goto")
                                (savePrint#funcall resstr pos type type_lexem)
                                (#if (!#unary (#\. this arguments (#quote \.) empty)).
                                    (#body
                                        (#\. this arguments (#[ 0) (#quote \.) (saveD#funcall resstr pos (-#unary tab (#quote -) 1) null (#\. this type)))
                                        (#foreach i arg (#\. this arguments (#[ 1 \.\. $))).
                                        (#body
                                            (savePrint#funcall resstr pos ", " pos)
                                            (#\. arg (saveD#funcall resstr pos (-#unary tab (#quote -) 1) null (#\. this type)))
                                        )
                                    ))

                                (#if (!#unary negtab).
                                    (#body
                                        (savePrint#funcall resstr pos ";" pos)
                                    ))
                                #break

                                (#case "for")
                                (savePrint#funcall resstr pos type type_lexem)
                                (savePrint#funcall resstr pos "(" open_lexem)
                                (#\. this arguments (#[ 0) (#quote \.) (saveD#funcall resstr pos (-#unary tab (#quote -) 1) null (#\. this type)))
                                (savePrint#funcall resstr pos ";" pos)
                                (#\. this arguments (#[ 1) (#quote \.) (saveD#funcall resstr pos (-#unary tab (#quote -) 1) null (#\. this type)))
                                (savePrint#funcall resstr pos ";" pos)
                                (#\. this arguments (#[ 2) (#quote \.) (saveD#funcall resstr pos (-#unary tab (#quote -) 1) null (#\. this type)))
                                (savePrint#funcall resstr pos ")" close_lexem)
                                (#if (!is postop null).
                                    (#body
                                        (#\. postop (saveD#funcall resstr pos tab))
                                    ))
                                #break

                                (#case "while")
                                (savePrint#funcall resstr pos type type_lexem)
                                (savePrint#funcall resstr pos "(" open_lexem)
                                (#\. this arguments (#[ 0) (#quote \.) (saveD#funcall resstr pos (-#unary tab (#quote -) 1) null (#\. this type)))
                                (savePrint#funcall resstr pos ")" close_lexem)
                                (#if (!is postop null).
