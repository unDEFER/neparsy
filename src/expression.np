            (#if (== type "code").(#body (= code this))
                (#quote else if) (&& (== type "enum") (== operator "LexemType")).(#body (= lexemTypes this))
                (#quote else if) (&& (== type "struct") (== operator "Lexer")).(#body (= lexer this)))

            (#if (&& (!is code null) (!is lexemTypes null) (#quote &&) (!is lexer null)).(#body #return))

            (#foreach . arg arguments).
            (#body
