                                                    (#if (== (#\. arg type) "[").
                                                        (#body
                                                            (#\. arg (saveD#funcall resstr pos (-#unary tab (#quote -) 1) null "op"))
                                                        )
                                                        (#quote else if) (== (#\. arg type) "init").
                                                        (#body
                                                            //savestr = "(" ~ savestr ~ ")";
(#if (!#unary quoted_op).
                                                                (#body (savePrint#funcall resstr pos (#\. this type) type_lexem)))
                                                            (#\. arg (saveD#funcall resstr pos (-#unary tab (#quote -) 1) null "op"))
                                                        )
                                                        #else.
                                                        (#body
                                                            (#if (!#unary quoted_op).
                                                                (#body (savePrint#funcall resstr pos (#\. this type) type_lexem)))
                                                            (#\. arg (saveD#funcall resstr pos (-#unary tab (#quote -) 1) null "op"))
