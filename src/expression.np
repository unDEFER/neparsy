                                        (savePrint#funcall resstr pos "," pos)
                                    ))
                                (#\. this arguments (#[ 1) (#quote \.) (saveD#funcall resstr pos (-#unary tab (#quote -) 1) null (#\. this type)))
                                (savePrint#funcall resstr pos ";" pos)
                                (#\. this arguments (#[ 2) (#quote \.) (saveD#funcall resstr pos (-#unary tab (#quote -) 1) null (#\. this type)))
                                (savePrint#funcall resstr pos ")" close_lexem)

                                (#if (!is postop null).
                                    (#body
                                        (#\. postop (saveD#funcall resstr pos tab))
                                    ))
                                #break

                                (#case "if")
                                (#case "static-if")
                                (#if (== type "static-if").
                                    (#body (savePrint#funcall resstr pos "static " type_lexem)))
                                (savePrint#funcall resstr pos "if" type_lexem)
                                (savePrint#funcall resstr pos "(" open_lexem)
                                (#if (!#unary (#\. operator empty)).
                                    (#body
                                        (savePrint#funcall resstr pos (~ operator " == ") operator_lexem)
                                    ))

                                (#\. this arguments (#[ 0) (#quote \.) (saveD#funcall resstr pos tab null "if"))

                                (savePrint#funcall resstr pos ")" close_lexem)

                                (#if (!is (#\. arguments (#[ 0) (#quote \.) postop) null).
                                    (#body (#\. arguments (#[ 0) (#quote \.) postop (#quote \.) (saveD#funcall resstr pos tab null))))

                                (= (or_need#var bool) (is (#\. arguments (#[ 0) (#quote \.) postop) null))
                                (= (else_if_quoted#var ubyte) 0)
                                (quote_expr#var Expression)
                                (#foreach i arg (#\. this arguments (#[ 1 \.\. $))).
                                (#body
                                    (#if (== (#\. arg bt) (#\. BlockType Comment)).
                                        (#body
                                            (#\. arg (saveD#funcall resstr pos tab null "if"))
                                        )
                                        (#quote else if) (== (#\. arg type) "else").
                                        (#body
                                            (savePrint#funcall resstr pos "else" (#\. arg type_lexem))
                                            (#\. arg (saveD#funcall resstr pos tab null "else"))
                                            (= or_need false)
                                        )
                                        (#quote else if) (== (#\. arg type) "quote").
                                        (#body
                                            (#if (&& (> (#\. arg arguments (#quote \.) length) 0) (== (#\. arg arguments (#[ 0) (#quote \.) operator) "else")).
                                                (#body
                                                    (++#post else_if_quoted)
                                                    (savePrint#funcall resstr pos "else" (#\. arg arguments (#[ 0) (#quote \.) operator_lexem))
                                                ))
                                            (#if (&& (> (#\. arg arguments (#quote \.) length) 1) (== (#\. arg arguments (#[ 1) (#quote \.) operator) "if")).
                                                (#body
                                                    (++#post else_if_quoted)
                                                    (savePrint#funcall resstr pos "if" (#\. arg arguments (#[ 1) (#quote \.) operator_lexem))
                                                    (= quote_expr arg)
                                                ))
                                        )
                                        (#quote else if) or_need.
                                        (#body
                                            (savePrint#funcall resstr pos " || " pos)
                                            (#if (!#unary (#\. operator empty)).
                                                (#body
                                                    (savePrint#funcall resstr pos (~ operator " == ") operator_lexem)
                                                ))
                                            (#\. arg (saveD#funcall resstr pos tab null "if"))
                                            (= or_need (is (#\. arg postop) null))
                                        )
                                        #else.
                                        (#body
                                            (#if (< else_if_quoted 1).
                                                (#body (savePrint#funcall resstr pos "else " type_lexem)))
                                            (#if (< else_if_quoted 2).
                                                (#body (savePrint#funcall resstr pos "if " type_lexem)))

                                            (#if (>= else_if_quoted 2).
                                                (#body (savePrint#funcall resstr pos "(" (#\. quote_expr open_lexem)))
                                                #else.
                                                (#body (savePrint#funcall resstr pos "(" pos)))

                                            (#if (!#unary (#\. operator empty)).
                                                (#body
                                                    (savePrint#funcall resstr pos (~ operator " == ") operator_lexem)
                                                ))
                                            (#\. arg (saveD#funcall resstr pos tab null "if"))
                                            (#if (>= else_if_quoted 2).
                                                (#body (savePrint#funcall resstr pos ")" (#\. quote_expr close_lexem)))
                                                #else.
                                                (#body (savePrint#funcall resstr pos ")" pos)))
                                            (#if (!is (#\. arg postop) null).
                                                (#body (#\. arg postop (#quote \.) (saveD#funcall resstr pos tab null))))
                                            (= or_need (is (#\. arg postop) null))
                                            (= else_if_quoted 0)
                                        ))
                                )
