                                (#case "foreach")
                                (#case "foreach_reverse")
                                (savePrint#funcall resstr pos type type_lexem)
                                (savePrint#funcall resstr pos "(" open_lexem)
                                (#if (!#unary (#\. this arguments (#[ 0) (#quote \.) operator (#quote \.) empty)).
                                    (#body
