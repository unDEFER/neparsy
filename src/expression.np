/**
 * expression.d
 */

(expression#module@D

    (#import std\.stdio)
    (#import std\.math)
    (#import std\.datetime)
    (#import std\.algorithm\.searching)
    (#import std\.algorithm\.mutation)
    (#import std\.conv)
    (#import std\.range\.primitives)
    (#import std\.utf)
    (#import std\.algorithm)
    (#import (std\.range (#quote :) repeat))
    (#import std\.array)
    (#import std\.string)
    (#import std\.file)
    (#import std\.ascii)

    (#import lexer)
    (#import iface)

    (BlockBE#struct

        (begin string)
        (end string)
        (escape string)
        (nested bool)
    )

    (BlockType#enum

        Code.(#init 0)
        String
        Character
        Comment
        File
    )

    (ParserState#struct

        (strings ([]#type BlockBE)).(#init [])
        (comments ([]#type BlockBE)).(#init [])
        (brackets BlockBE).(#init (BlockBE#funcall "(" ")" "\\" true))
        (sharp string).(#init "#")
        (at string).(#init "@")
        (dot string).(#init ".")
        (row uint).(#init 1)
    )

    (Expression#class

        (. x.(#init 0) y.(#init 0)).(real)
        (. r1 r2 r3).(real)
        (. d1 d2).(real)
        (. a1 a2).(real)
        (arat real)
        (brat real)
        (. pw mw).([]#type real)
        (c Color)
        (line int)
        (row int)
        (. block level levels).(int)
        (center Expression)
        (hidden bool)

        (operator_lexem Lexem)
        (type_lexem Lexem)
        (. open_lexem close_lexem).(Lexem)
        (. nl1 nl2).(int)

        (. start_pos_val end_pos_val).(Position)
        (. start_pos_calc end_pos_calc).(bool)

        (start_comment_val Position)
        (start_comment_path ([]#type uint))
        (start_comment_calc bool)
        (before_comments ([]#type Lexem))

        (start_pos#function Position).
        (#body
            (#if start_pos_calc.(#body (#return start_pos_val)))
            (= (pos#var Position) (#\. operator_lexem start))
            (#if (|| (== (#\. pos row) 0) (&& (> (#\. type_lexem start (#quote \.) row) 0) (< (#\. type_lexem start) pos))).(#body (= pos (#\. type_lexem start))))
            (#if (|| (== (#\. pos row) 0) (&& (> (#\. open_lexem start (#quote \.) row) 0) (< (#\. open_lexem start) pos))).(#body (= pos (#\. open_lexem start))))

            (#foreach . arg arguments).
            (#body
                (= (spos#var Position) (#\. arg start_pos#funcall))
                (#if (|| (== (#\. pos row) 0) (&& (> (#\. spos row) 0) (< spos pos))).(#body (= pos spos)))
            )

            (= start_pos_val pos)
            (= start_pos_calc true)
            (#return pos)
        )

        (start_comment#function Position (path ([]#type uint) out)).
        (#body
            (#if start_comment_calc.
                (#body
                    (= path start_comment_path)
                    (#return start_comment_val)
                ))
            (pos#var Position)
            (#foreach i comment_lexems ([] (#\. open_lexem comments) (#\. operator_lexem comments) (#\. type_lexem comments) (#\. close_lexem comments))).
            (#body
                (#foreach . com comment_lexems).
                (#body
                    (= (spos#var Position) (#\. com start))
                    (#if (|| (== (#\. pos row) 0) (&& (> (#\. spos row) 0) (< spos pos))).
                        (#body
                            (= pos spos)
                            (= path ([] (#cast uint i)))
                        ))
                )
            )

            (#if (#\. path empty).
                (#body
                    (mpath#var ([]#type uint))
                    (m#var uint)
                    (#foreach i arg arguments).
                    (#body
                        (spath#var ([]#type uint))
                        (= (spos#var Position) (#\. arg (start_comment#funcall spath)))
                        (#if (&& (!#unary (#\. spath empty)) (#ord (|| (== (#\. pos row) 0) (&& (> (#\. spos row) 0) (< spos pos))))).
                            (#body
                                (= pos spos)
                                (= m (#cast uint (#ord (+ i 1))))
                                (= mpath spath)
                            ))
                    )

                    (#if (> m 0).
                        (#body
                            (= path (~ ([] m) mpath))
                            (writefln#funcall "START_COMMENT %s: %s, %s" (*#unary (#ord (get_lexem_by_path#funcall path))) path pos)
                        ))
                )
                #else.
                (#body (writefln#funcall "START_COMMENT %s: %s, %s" (*#unary (#ord (get_lexem_by_path#funcall path))) path pos)))

            (= start_comment_val pos)
            (= start_comment_path path)
            (= start_comment_calc true)
            (#return pos)
        )

        (start_row#function uint).
        (#body
            (#return (#\. start_pos#funcall row))
        )

        (end_pos#function Position).
        (#body
            (#if end_pos_calc.(#body (#return end_pos_val)))
            (= (pos#var Position) (#\. operator_lexem end))
            (#if (> (#\. type_lexem end) pos).(#body (= pos (#\. type_lexem end))))
            (#if (> (#\. close_lexem end) pos).(#body (= pos (#\. close_lexem end))))

            (#foreach . arg arguments).
            (#body
                (= (spos#var Position) (#\. arg end_pos#funcall))
                (#if (> spos pos).(#body (= pos spos)))
            )

            (= end_pos_val pos)
            (= end_pos_calc true)
            (#return pos)
        )

        (end_row#function uint).
        (#body
            (#return (#\. end_pos#funcall row))
        )

        (operator string)
        (type string)
        (label string)

        (bt BlockType)
        (arguments ([]#type Expression))
        (postop Expression)
        (parent Expression)
        (index long)
        (focus_index long)

        (r#function real).(#body (#return (#\. c r)))
        (g#function real).(#body (#return (#\. c g)))
        (b#function real).(#body (#return (#\. c b)))
        (a#function real).(#body (#return (#\. c a)))

        (this#function #constructor).
        (#body
        )

        (#attr static).(getEscape#function dchar (c dchar)).
        (#body
            (#switch c).
            (#body
                (#case 'n')
                (#return '\n')
                (#case 'r')
                (#return '\r')
                (#case 't')
                (#return '\t')
                #default
                (#return c)
            )
        )

        (#attr static).(readEscaped#function string (line string) (escChar string)).
        (#body
            (= (res#var string) "")
            (escape#var bool)

            (#while (!#unary (#\. line empty))).
            (#body
                (#if escape.
                    (#body
                        (= escape false)
                        (= (c#var dchar) (#\. line decodeFront#funcall))
                        (~= res (getEscape#funcall c))
                    )
                    (#quote else if) (#\. line (startsWith#funcall escChar)).
                    (#body
                        (= escape true)
                        (= line (#\. line (#[ (#\. escChar length) \.\. $)))
                    )
                    #else.
                    (#body
                        (~= res (#\. line decodeFront#funcall))
                    ))
            )

            (#return res)
        )

        (getBlock#function string (line ([]#type char) ref) (be BlockBE)).
        (#body
            (= (sline#var ([]#type char)) line)
            (assert#funcall (#\. line (startsWith#funcall (#\. be begin))))
            (= line (#\. line (#[ (#\. be begin (#quote \.) length) \.\. $)))

            (escape#var bool)
            (nest#var int)
            (#while (!#unary (#\. line empty))).
            (#body
                (#if escape.
                    (#body
                        (= escape false)
                        (#\. line decodeFront#funcall)
                    )
                    (#quote else if) (&& (!#unary (#\. be escape (#quote \.) empty)) (#\. line (startsWith#funcall (#\. be escape)))).
                    (#body
                        (= escape true)
                        (= line (#\. line (#[ (#\. be escape (#quote \.) length) \.\. $)))
                    )
                    (#quote else if) (&& (#\. be nested) (#\. line (startsWith#funcall (#\. be begin)))).
                    (#body
                        (++#post nest)
                        (= line (#\. line (#[ (#\. be begin (#quote \.) length) \.\. $)))
                    )
                    (#quote else if) (#\. line (startsWith#funcall (#\. be end))).
                    (#body
                        (= line (#\. line (#[ (#\. be end (#quote \.) length) \.\. $)))
                        (= (ret#var ([]#type char)) (#\. sline (#[ 0 \.\. (- (#\. line ptr) (#\. sline ptr)))))
                        (#if (== nest 0).(#body (#return (#\. ret idup))))
                        (--#post nest)
                    )
                    #else.
                    (#body
                        (#\. line decodeFront#funcall)
                    ))
            )

            (#return (#\. sline (#[ 0 \.\. (- (#\. line ptr) (#\. sline ptr))) (#quote \.) idup))
        )

        (getBE#function BlockBE).
        (#body
            (= (be#var BlockBE) (BlockBE#funcall operator))
            (#foreach . arg arguments).
            (#body
                (#switch (#\. arg type)).
                (#body
                    (#case "end")
                    (= (#\. be end) (#\. arg operator))
                    #break
                    (#case "escape")
                    (= (#\. be escape) (#\. arg operator))
                    #break
                    (#case "nested")
                    (= (#\. be nested) true)
                    #break
                    #default
                    #break
                )
            )

            (#return be)
        )

        (startsWithDotBracket#function bool (line ([]#type char)) (ps ParserState)).
        (#body
            (#if (#\. line (startsWith#funcall (#\. ps dot))).
                (#body
                    (= line (#\. line (#[ (#\. ps dot (#quote \.) length) \.\. $)))

                    (#label WhileLineNotEmpty)
                    (#while (!#unary (#\. line empty))).
                    (#body
                        (#if (|| (== (#\. line (#[ 0)) ' ') (== (#\. line (#[ 0)) '\n')).
                            (#body
                                (#\. line decodeFront#funcall)
                                #continue
                            ))

                        (#foreach . be (#\. ps comments)).
                        (#body
                            (#if (#\. line (startsWith#funcall (#\. be begin))).
                                (#body
                                    (= (block#var string) (getBlock#funcall line be))
                                    (#continue WhileLineNotEmpty)
                                ))
                        )

                        #break
                    )

                    (#return (#\. line (startsWith#funcall (#\. ps brackets (#quote \.) begin))))
                ))
            (#return false)
        )

        (this#function #constructor (line ([]#type char) ref) (ps ParserState).(#init (#\. ParserState init)) (parent Expression).(#init null) (nofile bool).(#init false)).
        (#body
            (#if (is parent null).
                (#body
                    (= (#\. ps comments) ([] (BlockBE#funcall "/*" "*/")))
                    (= (#\. ps strings) ([] (BlockBE#funcall "\"" "\"" "\\") (BlockBE#funcall "'" "'" "\\")))

                    (#if (!#unary nofile).
                        (#body
                            (= bt (#\. BlockType File))
                            (comments#var ([]#type Lexem))
                            (#while (!#unary (#\. line empty))).
                            (#body
                                (= (sline#var ([]#type char)) line)
                                (= (ne#var auto) (#new (Expression#funcall line ps this)))
                                (#if (== sline line).(#body #return))
                                (#if (== (#\. ne bt) (#\. BlockType Comment)).
                                    (#body
                                        (~= comments (Lexem#funcall (#\. ne operator) (#\. LexemType Comment)))
                                        #continue
                                    ))

                                (= (#\. ne parent) this)
                                (= (#\. ne index) (#\. arguments length))
                                (= (#\. ne open_lexem (#quote \.) comments) comments)
                                (= comments [])
                                (~= arguments ne)
                            )
                            #return
                        ))
                ))

            (#label Init)
            (escaped_operator#var bool)
            (#while (&& (!#unary (#\. line empty)) (#ord (|| (== (#\. line (#[ 0)) ' ') (== (#\. line (#[ 0)) '\n'))))).
            (#body
                (= line (#\. line (#[ 1 \.\. $)))
            )

            (#foreach . be (#\. ps comments)).
            (#body
                (#if (#\. line (startsWith#funcall (#\. be begin))).
                    (#body
                        (= operator (getBlock#funcall line be))
                        (= bt (#\. BlockType Comment))
                        #return
                    ))
            )

            (in_brackets#var bool)
            (= (brackets#var BlockBE) (#\. ps brackets))

            (#if (#\. line (startsWith#funcall (#\. ps brackets (#quote \.) begin))).
                (#body
                    (= line (#\. line (#[ (#\. ps brackets (#quote \.) begin (#quote \.) length) \.\. $)))
                    (= in_brackets true)
                    (= arguments ([] null))
                    (= (#\. arguments length) 0)
                    (assert#funcall (!is arguments null))
                ))

            (#foreach . be (#\. ps strings)).
            (#body
                (#if (#\. line (startsWith#funcall (#\. be begin))).
                    (#body
                        (= operator (getBlock#funcall line be))
                        (= bt (#\. BlockType String))

                        (#if (#\. line (startsWith#funcall (#\. ps sharp))).
                            (#body
                                (= line (#\. line (#[ (#\. ps sharp (#quote \.) length) \.\. $)))
                                (#goto Sharp)
                            )
                            (#quote else if) (#\. line (startsWith#funcall (#\. ps at))).
                            (#body
                                (= line (#\. line (#[ (#\. ps at (#quote \.) length) \.\. $)))
                                (#goto At)
                            )
                            #else.(#body (#goto Arguments)))
                    ))
            )

            (#while (!#unary (#\. line empty))).
            (#body
                (#if (#\. line (startsWith#funcall (#\. ps brackets (#quote \.) begin))).
                    (#body
                        (#goto Arguments)
                    )
                    (#quote else if) (#\. line (startsWith#funcall (#\. ps brackets (#quote \.) escape))).
                    (#body
                        (= line (#\. line (#[ (#\. ps brackets (#quote \.) escape (#quote \.) length) \.\. $)))
                        (= (c#var dchar) (#\. line decodeFront#funcall))
                        (~= operator (getEscape#funcall c))
                        (= escaped_operator true)
                    )
                    (#quote else if) (|| (== (#\. line (#[ 0)) ' ') (== (#\. line (#[ 0)) '\n')).
                    (#body
                        (#goto Arguments)
                    )
                    (#quote else if) (#\. line (startsWith#funcall (#\. ps brackets (#quote \.) end))).
                    (#body
                        (#if in_brackets.
                            (#body
                                (= line (#\. line (#[ (#\. ps brackets (#quote \.) end (#quote \.) length) \.\. $)))
                                (#goto Post)
                            ))
                        (#goto End)
                    )
                    (#quote else if) (&& (!#unary in_brackets) (startsWithDotBracket#funcall line ps)).
                    (#body
                        (#goto Post)
                    )
                    (#quote else if) (#\. line (startsWith#funcall (#\. ps sharp))).
                    (#body
                        (= line (#\. line (#[ (#\. ps sharp (#quote \.) length) \.\. $)))
                        (#goto Sharp)
                    )
                    (#quote else if) (#\. line (startsWith#funcall (#\. ps at))).
                    (#body
                        (= line (#\. line (#[ (#\. ps at (#quote \.) length) \.\. $)))
                        (#goto At)
                    )
                    #else.
                    (#body (~= operator (#\. line decodeFront#funcall))))
            )

            (#label Sharp)
            (#while (!#unary (#\. line empty))).
            (#body
                (#if (#\. line (startsWith#funcall (#\. ps brackets (#quote \.) begin))).
                    (#body
                        (#goto Arguments)
                    )
                    (#quote else if) (#\. line (startsWith#funcall (#\. ps brackets (#quote \.) escape))).
                    (#body
                        (= line (#\. line (#[ (#\. ps brackets (#quote \.) escape (#quote \.) length) \.\. $)))
                        (= (c#var dchar) (#\. line decodeFront#funcall))
                        (~= type (getEscape#funcall c))
                    )
                    (#quote else if) (|| (== (#\. line (#[ 0)) ' ') (== (#\. line (#[ 0)) '\n')).
                    (#body
                        (#goto Arguments)
                    )
                    (#quote else if) (#\. line (startsWith#funcall (#\. ps brackets (#quote \.) end))).
                    (#body
                        (#if in_brackets.
                            (#body
                                (= line (#\. line (#[ (#\. ps brackets (#quote \.) end (#quote \.) length) \.\. $)))
                                (#goto Post)
                            ))
                        (#goto End)
                    )
                    (#quote else if) (&& (!#unary in_brackets) (startsWithDotBracket#funcall line ps)).
                    (#body
                        (#goto Post)
                    )
                    (#quote else if) (#\. line (startsWith#funcall (#\. ps at))).
                    (#body
                        (= line (#\. line (#[ (#\. ps at (#quote \.) length) \.\. $)))
                        (#goto At)
                    )
                    #else.
                    (#body (~= type (#\. line decodeFront#funcall))))
            )

            (#label At)
            (#while (!#unary (#\. line empty))).
            (#body
                (#if (#\. line (startsWith#funcall (#\. ps brackets (#quote \.) end))).
                    (#body
                        (#if in_brackets.
                            (#body
                                (= line (#\. line (#[ (#\. ps brackets (#quote \.) end (#quote \.) length) \.\. $)))
                                (#goto Post)
                            ))
                        (#goto End)
                    )
                    (#quote else if) (#\. line (startsWith#funcall (#\. ps brackets (#quote \.) escape))).
                    (#body
                        (= line (#\. line (#[ (#\. ps brackets (#quote \.) escape (#quote \.) length) \.\. $)))
                        (= (c#var dchar) (#\. line decodeFront#funcall))
                        (~= label (getEscape#funcall c))
                    )
                    (#quote else if) (#\. line (startsWith#funcall (#\. ps brackets (#quote \.) begin))).
                    (#body
                        (#goto Arguments)
                    )
                    (#quote else if) (|| (== (#\. line (#[ 0)) ' ') (== (#\. line (#[ 0)) '\n')).
                    (#body
                        (#goto Arguments)
                    )
                    (#quote else if) (&& (!#unary in_brackets) (startsWithDotBracket#funcall line ps)).
                    (#body
                        (#goto Post)
                    )
                    #else.
                    (#body (~= label (#\. line decodeFront#funcall))))
            )

            (#label Arguments)
            (#if (== type "module").
                (#body
                    (#switch label).
                    (#body
                        (#case "D")
                        (#case "Lexer")
                        (= (#\. ps comments) ([] (BlockBE#funcall "//" "\n") (BlockBE#funcall "/*" "*/") (BlockBE#funcall "/+" "+/" null true)))
                        (= (#\. ps strings) ([] (BlockBE#funcall "\"" "\"" "\\") (BlockBE#funcall "'" "'" "\\")))
                        #break
                        #default
                        #break
                    )
                ))

            (#if in_brackets.
                (#body
                    (comments#var ([]#type Lexem))
                    (#while (!#unary (#\. line empty))).
                    (#body
                        (#if (#\. line (startsWith#funcall (#\. ps brackets (#quote \.) end))).
                            (#body
                                (= line (#\. line (#[ (#\. ps brackets (#quote \.) end (#quote \.) length) \.\. $)))
                                (#goto Post)
                            )
                            (#quote else if) (|| (== (#\. line (#[ 0)) ' ') (== (#\. line (#[ 0)) '\n')).
                            (#body
                                (= line (#\. line (#[ 1 \.\. $)))
                            )
                            #else.
                            (#body
                                (= (ne#var auto) (#new (Expression#funcall line ps this)))
                                (#if (== (#\. ne bt) (#\. BlockType Comment)).
                                    (#body
                                        (~= comments (Lexem#funcall (#\. ne operator) (#\. LexemType Comment)))
                                        #continue
                                    ))
                                (= (#\. ne open_lexem (#quote \.) comments) comments)
                                (= comments [])

                                (#if (&& (== (#\. ne operator) (#\. ps dot)) (!#unary (#\. ne arguments (#quote \.) empty))).
                                    (#body
                                        (#foreach . arg (#\. ne arguments)).
                                        (#body
                                            (= (#\. arg parent) this)
                                            (+= (#\. arg index) (#\. arguments length))
                                        )

                                        (~= arguments (#\. ne arguments))

                                        (#if (!is (#\. ne postop) null).
                                            (#body
                                                (= (#\. ne postop (#quote \.) parent) (#\. arguments (#[ (- $ 1))))
                                                (= (#\. ne postop (#quote \.) index) (-#unary (#\. ne arguments (#quote \.) length)))
                                            ))

                                        (#\. arguments (#[ (- $ 1)) (#quote \.) (addPosts#funcall ([] (#\. ne postop))))
                                    )
                                    #else.
                                    (#body
                                        (= (#\. ne parent) this)
                                        (= (#\. ne index) (#\. arguments length))
                                        (~= arguments ne)
                                    ))
                            ))
                    )
                    (assert#funcall 0 "Not closed bracket")
                ))

            (#label Post)
            (#if (startsWithDotBracket#funcall line ps).
                (#body
                    (= line (#\. line (#[ (#\. ps dot (#quote \.) length) \.\. $)))
                    (ne#var Expression)
                    (comments#var ([]#type Lexem))
                    (#while true).
                    (#body
                        (= ne (#new (Expression#funcall line ps this)))
                        (#if (== (#\. ne bt) (#\. BlockType Comment)).
                            (#body
                                (~= comments (Lexem#funcall (#\. ne operator) (#\. LexemType Comment)))
                                #continue
                            ))
                        #break
                    )

                    (= (#\. ne open_lexem (#quote \.) comments) comments)
                    (= (#\. ne parent) this)
                    (= (#\. ne index) (-#unary 1))
                    (= postop ne)
                ))

            (#label End)

            (#if (&& (== operator (#\. ps dot)) (!#unary escaped_operator) (#quote &&) (== (#\. arguments length) 0)).
                (#body (= operator null)))

            (= (eline#var auto) line)
            (#while (&& (!#unary (#\. eline empty)) (#ord (|| (== (#\. eline (#[ 0)) ' ') (== (#\. eline (#[ 0)) '\n'))))).
            (#body
                (= eline (#\. eline (#[ 1 \.\. $)))
            )
            (#if (#\. eline empty).(#body (= line eline)))

            (= (#\. operator_lexem text) operator)
            (= (#\. type_lexem text) type)
        )

        (this#function #constructor (line string) (nofile bool).(#init false)).
        (#body
            (= (l#var ([]#type char)) (#\. line dup))
            (this#funcall l (#\. ParserState init) null nofile)
            (#if (!#unary (#\. l empty)).
                (#body (writefln#funcall "NOT PARSED TAIL: %s" (#\. l (#[ 0 \.\. (min#funcall 30 $))))))
        )

        (addChild#function void (c Expression)).
        (#body
            (= (#\. c parent) this)
            (= (#\. c index) (#\. arguments length))
            (~= arguments c)
        )

        (addChilds#function void (cc ([]#type Expression))).
        (#body
            (#foreach i c cc).
            (#body
                (= (#\. c parent) this)
                (= (#\. c index) (+ (#\. arguments length) i))
            )

            (~= arguments cc)
        )

        (addPosts#function void (cc ([]#type Expression))).
        (#body
            (= (pp#var Expression) this)
            (#while (!is (#\. pp postop) null)).(#body (= pp (#\. pp postop)))
            (#foreach i c cc).
            (#body
                (= (#\. pp postop) c)
                (= (#\. c parent) pp)
                (#if (>= (#\. c index) 0).(#body (= (#\. c index) (-#unary 1))))
                (= pp c)
            )
        )

        (popChild#function Expression).
        (#body
            (#if (#\. arguments empty).(#body (#return null)))
            (= (ret#var auto) (#\. arguments (#[ (- $ 1))))
            (= arguments (#\. arguments (#[ 0 \.\. (- $ 1))))
            (#return ret)
        )

        (fixParents#function void (p Expression).(#init null) (i long).(#init 0)).
        (#body
            (= parent p)
            (assert#funcall (!is p this))
            (assert#funcall (|| (&& (>= i 0) (>= index 0)) (&& (< i 0) (<= index 0))))
            (#if (>= index (-#unary 1)).
                (#body (= index i)))

            (#foreach ind arg arguments).
            (#body
                (#\. arg (fixParents#funcall this ind))
            )

            (#if (!is postop null).
                (#body
                    (#\. postop (fixParents#funcall this (-#unary 1)))
                ))
        )

        (#attr static).(escape#function string (str string) (be BlockBE) (space bool).(#init true) (dot bool).(#init true)).
        (#body
            (#if (#\. be escape (#quote \.) empty).(#body (#return str)))

            (res#var string)
            (#while (!#unary (#\. str empty))).
            (#body
                (#if (|| (#\. str (startsWith#funcall (#\. be begin))) (#\. str (startsWith#funcall (#\. be end))) (#quote ||) (#\. str (startsWith#funcall (#\. be escape))) (#quote ||) (&& space (#\. str (startsWith#funcall " "))) (#quote ||) (&& dot (#\. str (startsWith#funcall ".")))).
                    (#body
                        (~= res (#\. be escape))
                        (~= res (#\. str decodeFront#funcall))
                    )
                    (#quote else if) (#\. str (startsWith#funcall "\n")).
                    (#body
                        (~= res (#\. be escape))
                        (~= res "n")
                        (#\. str decodeFront#funcall)
                    )
                    (#quote else if) (#\. str (startsWith#funcall "\r")).
                    (#body
                        (~= res (#\. be escape))
                        (~= res "r")
                        (#\. str decodeFront#funcall)
                    )
                    (#quote else if) (#\. str (startsWith#funcall "\t")).
                    (#body
                        (~= res (#\. be escape))
                        (~= res "t")
                        (#\. str decodeFront#funcall)
                    )
                    #else.
                    (#body
                        (~= res (#\. str decodeFront#funcall))
                    ))
            )

            (#return res)
        )

        (save#function string (inp bool).(#init false)).
        (#body
            (ps#var ParserState)
            (#return (save#funcall ps inp))
        )

        (lexem_lines#function string (lexem Lexem) (include_end bool).(#init false)).
        (#body
            (#return (#ord (#? (&& (!is (#\. lexem text) null) (> (#\. lexem start (#quote \.) row) 0)) (~ ":" (#\. lexem start (#quote \.) row (#quote \.) text) (#quote ~) ":" (#quote ~) (#\. lexem start (#quote \.) col (#quote \.) text) (#quote ~)
                            (#ord (#? (&& include_end (> (#\. lexem end (#quote \.) row) 0)) (~ "-" ":" (#quote ~) (#\. lexem end (#quote \.) row (#quote \.) text) (#quote ~) ":" (#quote ~) (#\. lexem end (#quote \.) col (#quote \.) text)) (#quote :) ""))) (#quote :) "")))
        )

        (get_lexem_by_path#function (*#type Lexem) (path ([]#type uint))).
        (#body
            (#if (== (#\. path length) 0).(#body (#return null)))

            (= (t#var Expression) this)
            (#foreach . p (#\. path (#[ 0 \.\. (- $ 1)))).
            (#body
                (#if (>= (- p 1) (#\. t arguments (#quote \.) length)).(#body (#return null)))
                (= t (#\. t arguments (#[ (- p 1))))
            )

            (writefln#funcall "PATH %s AT %s" path t)
            (#switch (#\. path (#[ (- $ 1)))).
            (#body
                (#case 0)
                (#return (&#unary (#\. t open_lexem)))
                (#case 1)
                (#return (&#unary (#\. t operator_lexem)))
                (#case 2)
                (#return (&#unary (#\. t type_lexem)))
                (#case 3)
                (#return (&#unary (#\. t close_lexem)))
                #default
                (assert#funcall 0)
            )
        )

        (save#function string (ps ParserState ref) (inp bool).(#init false) (tab int).(#init 0) (cbr ([]#type long)).(#init null) (force_brackets bool).(#init false)).
        (#body
            (savestr#var string)
            (comments#var string)
            (path#var ([]#type uint))
            (= (pos#var Position) (start_comment#funcall path))

            (#if (&& (is before_comments null) (> (#\. path length) 1) (#quote &&) (!= bt (#\. BlockType File)) (#quote &&) (> (#\. pos row) 0) (#quote &&) (< (#\. pos row) start_row#funcall)).
                (#body
                    (= (l#var (*#type Lexem)) (get_lexem_by_path#funcall path))
                    (= before_comments (#\. l comments))
                    (= (#\. l comments) null)
                ))

            (= (types#var ([]#type string)) ([] "OPEN" "OPERATOR" "TYPE" "CLOSE"))
            (#foreach i comment_lexems ([] before_comments (#\. open_lexem comments) (#\. operator_lexem comments) (#\. type_lexem comments) (#\. close_lexem comments))).
            (#body
                (#foreach . com comment_lexems).
                (#body
                    (= (srow#var uint) (#\. com start (#quote \.) row))
                    (~= comments (#\. (#ord (#? (> srow (#\. ps row)) (~ (#\. '\n' (repeat#funcall (- srow (#\. ps row))) (#quote \.) array) (#\. ' ' (repeat#funcall (* tab 4)) (#quote \.) array)) (#quote :) "")) idup))
                    (#if (> srow (#\. ps row)).(#body (= (#\. ps row) srow)))

                    (#if inp.
                        (#body
                            (#if (== i 0).
                                (#body
                                    (~= comments (~ "/*" (#\. path (#[ 0 \.\. (- $ 1)) (#quote \.) (map (#! (=> a (#\. a text)))) (#quote \.) (join#funcall "#")) (#quote ~) "#" (#quote ~) (#\. types (#[ (#\. path (#[ (- $ 1))))) (#quote ~) (lexem_lines#funcall com true) (#quote ~) "*/"))
                                )
                                #else.
                                (#body
                                    (~= comments (~ "/*" (#\. types (#[ (- i 1))) (#quote ~) (lexem_lines#funcall com true) (#quote ~) "*/"))
                                ))
                        )
                        #else.
                        (#body
                            (~= comments (#\. com text))
                            (= (comment#var string) (#\. com text))
                            (#while 1).(#body
                                (= (newline#var string) (#\. comment (find#funcall "\n")))
                                (#if (!#unary (#\. newline empty)).
                                    (#body
                                        (++#post (#\. ps row))
                                        (= comment newline)
                                        (#\. comment decodeFront#funcall)
                                    )
                                    #else.
                                    (#body
                                        #break
                                    ))
                            )
                        ))
                )
            )

            (= (srow#var uint) start_row#funcall)
            (= (prewhites#var string) (#\. (#ord (#? (> srow (#\. ps row)) (~ (#\. '\n' (repeat#funcall (- srow (#\. ps row))) (#quote \.) array) (#\. ' ' (repeat#funcall (* tab 4)) (#quote \.) array)) (#quote :) "")) idup))
            (#if (> srow (#\. ps row)).(#body (= (#\. ps row) srow)))

            (#if (== bt (#\. BlockType File)).
                (#body
                    (= (#\. ps row) 1)
                    (= prewhites "")
                )
                (#quote else if) (|| (== bt (#\. BlockType String)) (== bt (#\. BlockType Character))).
                (#body
                    (= (bbe#var auto) (#\. ps brackets))
                    (#if inp.
                        (#body
                            (~= savestr (~ (lexem_lines#funcall operator_lexem true) (#ord (#? (#\. this type (#quote \.) empty) "" (#quote :) (~ (#\. ps sharp) (lexem_lines#funcall type_lexem))))))
                        )
                        #else.
                        (#body
                            (~= savestr (~ operator (#ord (#? (#\. this type (#quote \.) empty) "" (#quote :) (~ (#\. ps sharp) (escape#funcall type bbe))))))
                        ))
                )
                #else.
                (#body
                    (= (bbe#var auto) (#\. ps brackets))
                    (#if inp.
                        (#body
                            (~= savestr (~ (lexem_lines#funcall operator_lexem) (#ord (#? (#\. this type (#quote \.) empty) "" (#quote :) (~ (#\. ps sharp) (lexem_lines#funcall type_lexem)))) (#quote ~) (#ord (#? (&& (#\. open_lexem text (#quote \.) empty) (#\. close_lexem text (#quote \.) empty)) "" (#quote :) (~ "[" (lexem_lines#funcall open_lexem) (#quote ~) "-" (#quote ~) (lexem_lines#funcall close_lexem) (#quote ~) "]")))))
                        )
                        #else.
                        (#body
                            (~= savestr (~ (escape#funcall operator bbe) (#ord (#? (#\. this type (#quote \.) empty) "" (#quote :) (~ (#\. ps sharp) (escape#funcall type bbe)))) (#quote ~) (#ord (#? (#\. this label (#quote \.) empty) "" (#quote :) (~ (#\. ps at) (escape#funcall label bbe))))))
                        ))
                ))

            (#if (&& (#\. savestr empty) (!= bt (#\. BlockType File))).
                (#body (= savestr (#\. ps dot))))

            (#if (!#unary (#\. this arguments (#quote \.) empty)).
                (#body
                    (. a#var b#var c#var).([]#type long)
                    (#foreach i arg (#\. this arguments)).
                    (#body
                        (= (arg2#var auto) (#\. arg postop))
                        (j#var long)
                        (#while (!is arg2 null)).
                        (#body
                            (#if (< (#\. arg2 index) (-#unary 1)).
                                (#body
                                    (~= a (+ i (#\. arg2 index) (#quote +) 1))
                                    (~= b i)
                                    (~= c j)
                                ))

                            (= arg2 (#\. arg2 postop))
                            (++#post j)
                        )
                    )

                    (#foreach i arg (#\. this arguments)).
                    (#body
                        (#foreach . m a).
                        (#body
                            (#if (== m i).
                                (#body
                                    (= (arow#var uint) (#\. arg start_row#funcall))
                                    (= (aprewhites#var string) (#\. (#ord (#? (> arow (#\. ps row)) (~ (#\. '\n' (repeat#funcall (- arow (#\. ps row))) (#quote \.) array) (#\. ' ' (repeat#funcall (* (#ord (+ tab 1)) 4)) (#quote \.) array)) (#quote :) " ")) idup))
                                    (#if (> arow (#\. ps row)).(#body (= (#\. ps row) arow)))
                                    (~= savestr (~ aprewhites (#\. ps brackets (#quote \.) begin) (#quote ~) (#\. ps dot)))
                                ))
                        )

                        (br#var ([]#type long))
                        (#foreach j m b).
                        (#body
                            (#if (== m i).
                                (#body
                                    (~= br (#\. c (#[ j)))
                                ))
                        )

                        (#if (== bt (#\. BlockType File)).
                            (#body (~= savestr (#\. arg (save#funcall ps inp 0 br false))))
                            #else.
                            (#body
                                (= (as#var auto) (#\. arg (save#funcall ps inp (+ tab 1) br false)))
                                (#if (|| (#\. as (startsWith#funcall " ")) (#\. as (startsWith#funcall "\n"))).
                                    (#body (~= savestr as))
                                    #else.
                                    (#body (~= savestr (~ " " as))))
                            ))
                    )

                    (#if (!= bt (#\. BlockType File)).
                        (#body
                            (= (erow#var uint) end_row#funcall)
                            (= savestr (~ (#\. ps brackets (#quote \.) begin) savestr (#quote ~)
                                    (#\. (#ord (#? (> erow (#\. ps row)) (~ (#\. '\n' (repeat#funcall (- erow (#\. ps row))) (#quote \.) array) (#\. ' ' (repeat#funcall (* tab 4)) (#quote \.) array)) (#quote :) "")) idup) (#quote ~)
                                    (#\. ps brackets (#quote \.) end)))
                            (#if (> erow (#\. ps row)).(#body (= (#\. ps row) erow)))
                        ))
                )
                (#quote else if) (|| force_brackets (!is arguments null)).
                (#body
                    (= (erow#var uint) end_row#funcall)
                    (= savestr (~ (#\. ps brackets (#quote \.) begin) savestr (#quote ~)
                            (#\. (#ord (#? (> erow (#\. ps row)) (~ (#\. '\n' (repeat#funcall (- erow (#\. ps row))) (#quote \.) array) (#\. ' ' (repeat#funcall (* tab 4)) (#quote \.) array)) (#quote :) "")) idup) (#quote ~)
                            (#\. ps brackets (#quote \.) end)))
                    (#if (> erow (#\. ps row)).(#body (= (#\. ps row) erow)))
                )
                (#quote else if) (> (#\. close_lexem end (#quote \.) row) (#\. ps row)).
                (#body
                    (= (erow#var uint) end_row#funcall)
                    (~= savestr (#\. (#ord (~ (#\. '\n' (repeat#funcall (- erow (#\. ps row))) (#quote \.) array) (#\. ' ' (repeat#funcall (* tab 4)) (#quote \.) array))) idup))
                    (#if (> erow (#\. ps row)).(#body (= (#\. ps row) erow)))
                ))

            (= savestr (~ prewhites savestr))

            (#if (>= index 0).
                (#body
                    (= (cj#var long) 0)

                    (= (arg#var auto) postop)
                    (j#var long)
                    (#while (!is arg null)).
                    (#body
                        (#if (&& (< cj (#\. cbr length)) (== (#\. cbr (#[ cj)) j)).
                            (#body
                                (~= savestr (#\. ps brackets (#quote \.) end))
                                (++#post cj)
                            ))

                        (~= savestr (~ (#\. ps dot) (#\. arg (save#funcall ps inp tab null true))))
                        (= arg (#\. arg postop))
                        (++#post j)
                    )
                ))

            (#return (~ comments savestr))
        )

        (#attr static).(parse_position#function bool (itext string ref) (pos Position ref)).
        (#body
            (#if (!= (#\. itext (#[ 0)) ':').(#body (#return false)))
            (= itext (#\. itext (#[ 1 \.\. $)))
            (= (#\. pos row) (parse (#! uint string) itext))

            (#if (!= (#\. itext (#[ 0)) ':').(#body (#return false)))
            (= itext (#\. itext (#[ 1 \.\. $)))
            (= (#\. pos col) (parse (#! uint string) itext))
            (#return true)
        )

        (#attr static).(parse_path#function bool (itext string ref) (path ([]#type uint) ref)).
        (#body
            (writefln#funcall "ITEXT %s" itext)
            (#if (== (#\. itext (#[ 0 \.\. 2)) "/*").(#body (= itext (#\. itext (#[ 2 \.\. $)))))
            (#while (#\. itext (#[ 0) (#quote \.) isDigit#funcall)).
            (#body
                (~= path (parse (#! uint string) itext))
                (#if (== (#\. itext (#[ 0)) '#').(#body (= itext (#\. itext (#[ 1 \.\. $)))))
            )

            (= (types#var ([]#type string)) ([] "OPEN" "OPERATOR" "TYPE" "CLOSE"))

            (#foreach i type types).
            (#body
                (#if (#\. itext (startsWith#funcall type)).
                    (#body
                        (~= path (#cast uint i))
                        (= itext (#\. itext (#[ (#\. type length) \.\. $)))
                        (writefln#funcall "PATH %s" path)
                        (#return true)
                    ))
            )
            (#return false)
        )

        (merge_indent_info#function void (a Lexem ref) (i Lexem ref) (ol Lexem ref) (cl Lexem ref)).
        (#body
            (pos#var Position)
            (= (itext#var string) (#\. i text))

            (#if (#\. itext empty).(#body #return))
            (parse_position#funcall itext (#\. a start))

            (#if (#\. itext empty).(#body #return))
            (#if (== (#\. itext (#[ 0)) '-').
                (#body
                    (= itext (#\. itext (#[ 1 \.\. $)))
                    (parse_position#funcall itext (#\. a end))
                ))

            (#if (#\. itext empty).(#body #return))
            (#if (== (#\. itext (#[ 0)) '[').
                (#body
                    (= itext (#\. itext (#[ 1 \.\. $)))

                    (#if (parse_position#funcall itext (#\. ol start)).
                        (#body
                            (= (#\. ol text) "$")
                        ))

                    (#if (== (#\. itext (#[ 0)) '-').
                        (#body
                            (= itext (#\. itext (#[ 1 \.\. $)))

                            (#if (parse_position#funcall itext (#\. cl end)).
                                (#body
                                    (= (#\. cl text) "$")
                                    (= (#\. cl start) (#\. cl end))
                                ))
                        ))
                ))
        )

        (merge_inp#function void (inp Expression)).
        (#body
            (merge_indent_info#funcall operator_lexem (#\. inp operator_lexem) open_lexem close_lexem)
            (merge_indent_info#funcall type_lexem (#\. inp type_lexem) open_lexem close_lexem)

            (#if (!= (#\. open_lexem comments (#quote \.) length) (#\. inp open_lexem (#quote \.) comments (#quote \.) length)).(#body #return))
            (#for (= (i int) 0) (< i (#\. open_lexem comments (#quote \.) length)) (++#post i)).
            (#body
                (= (com#var Lexem) (#\. open_lexem comments (#[ i)))
                (= (icom#var Lexem) (#\. inp open_lexem (#quote \.) comments (#[ i)))

                (= (itext#var string) (#\. icom text))
                (path#var ([]#type uint))
                (#if (!#unary (parse_path#funcall itext path)).(#body #continue))
                (parse_position#funcall itext (#\. com start))
                (#if (== (#\. itext (#[ 0)) '-').
                    (#body
                        (= itext (#\. itext (#[ 1 \.\. $)))
                        (parse_position#funcall itext (#\. com end))
                    ))

                (#if (== path ([] 0)).
                    (#body
                        (= (#\. open_lexem comments (#[ i)) com)
                        #continue
                    ))

                (writefln#funcall "COM %s, path %s" (#\. com text) path)
                (= (l#var (*#type Lexem)) (get_lexem_by_path#funcall path))
                (= (il#var (*#type Lexem)) (#\. inp (get_lexem_by_path#funcall path)))
                (#if (|| (is l null) (is il null)).(#body #return))
                (= (#\. icom text) "***")
                (~= (#\. l comments) com)
                (~= (#\. il comments) icom)

                (= (#\. open_lexem comments) (~ (#\. open_lexem comments (#[ 0 \.\. i)) (#\. open_lexem comments (#[ (+ i 1) \.\. $))))
                (= (#\. inp open_lexem (#quote \.) comments) (~ (#\. inp open_lexem (#quote \.) comments (#[ 0 \.\. i)) (#\. inp open_lexem (#quote \.) comments (#[ (+ i 1) \.\. $))))

                (--#post i)
            )

            (#if (!= (#\. arguments length) (#\. inp arguments (#quote \.) length)).(#body #return))
            (#foreach i arg (#\. this arguments)).
            (#body
                (#\. arg (merge_inp#funcall (#\. inp arguments (#[ i))))
            )

            (#if (!is postop null).
                (#body
                    (#\. postop (merge_inp#funcall (#\. inp postop)))
                ))
        )

        (wrapWithSpaces#function string (str string) (tabstr string) (pos Position ref)).
        (#body
            (#return str)
        )

        (beforeSpaces#function string (tabstr string) (pos Position ref)).
        (#body
            (#return "")
        )

        (afterSpaces#function string (pos Position ref)).
        (#body
            (#return "")
        )

        (saveD#function string).
        (#body
            (= (pos#var Position) (Position#funcall 1 1))
            (resstr#var string)
            (saveD#funcall resstr pos)
            (#return resstr)
        )

        (savePrint#function void (resstr string ref) (pos Position ref) (str string) (spos Position)).
        (#body
            (#if (> spos pos).
                (#body
                    (~= resstr (~ (#\. '\n' (repeat#funcall (- (#\. spos row) (#\. pos row))) (#quote \.) array (#quote \.) idup#funcall) (#\. ' ' (repeat#funcall (- (#\. spos col) (#ord (#? (> (#\. spos row) (#\. pos row)) 1 (#quote :) (#\. pos col))))) (#quote \.) array (#quote \.) idup#funcall)))
                    (= pos spos)
                ))

            (~= resstr str)

            (#while 1).(#body
                (= (newline#var string) (#\. str (find#funcall "\n")))
                (#if (!#unary (#\. newline empty)).
                    (#body
                        (++#post (#\. pos row))
                        (= (#\. pos col) 1)
                        (= str newline)
                        (#\. str decodeFront#funcall)
                    )
                    #else.
                    (#body
                        (+= (#\. pos col) (#cast uint (#\. str walkLength#funcall)))
                        #break
                    ))
            )
        )

        (savePrint#function void (resstr string ref) (pos Position ref) (comments ([]#type Lexem))).
        (#body
            (#foreach . com comments).
            (#body
                (savePrint#funcall resstr pos (#\. com text) (#\. com start))
            )
        )

        (savePrint#function void (resstr string ref) (pos Position ref) (str string) (lexem Lexem)).
        (#body
            (savePrint#funcall resstr pos (#\. lexem comments))
            (savePrint#funcall resstr pos str (#\. lexem start))
        )

        (saveD#function string (resstr string ref) (pos Position ref) (tab int).(#init 0) (post ([]#type Expression)).(#init null) (ptype string).(#init null)).
        (#body
            (savestr#var string)
            (= (tabstr#var string) "")
            (negtab#var bool)
            (#if (< tab 0).
                (#body
                    (= negtab true)
                    (= tab (-#unary tab))
                ))

            (#if (> tab 0).(#body (= tabstr (#\. ' ' (repeat#funcall (* tab 4)) (#quote \.) array))))
            (writefln#funcall "%s %s %s %s => %s" tabstr bt this start_pos#funcall end_pos#funcall)

            (= (handled#var bool) true)
            (#switch ptype).
            (#body
                (#case "struct")
                (#case "module")
                (#case "class")
                (#case "function")
                (#case "ctype")
                (#if (&& (!#unary (#\. this type (#quote \.) empty)) (!= (#\. this type) "constructor")).
                    (#body
                        (= handled false)
                        #break
                    ))

                (#foreach_reverse i arg (#\. this arguments)).
                (#body
                    (#\. arg (saveD#funcall resstr pos (-#unary tab (#quote -) 1) null (#ord (#? (== i 0) "type" (#quote :) "attr"))))
                )

                (#if (&& (!is parent null) (>= index 0) (#quote &&) (> (#\. parent arguments (#quote \.) length) index)).
                    (#body
                        (#foreach i arg (#\. parent arguments (#[ index \.\. $))).
                        (#body
                            (= (ap#var auto) (#\. arg postop))
                            (#while (!is ap null)).
                            (#body
                                //writefln("%s -- %s (%s == %s)", this, ap.index, arg.index + ap.index + 1, this.index);
(#if (== (+ (#\. arg index) (#\. ap index) (#quote +) 1) (#\. this index)).
                                    (#body
                                        (#if (== (#\. ap operator) "[]").
                                            (#body
                                                (#\. ap (saveD#funcall resstr pos tab))
                                            )
                                            (#quote else if) (== (#\. ap type) "init").
                                            (#body
                                            )
                                            #else.



                                            //writefln("%s -- %s-%s", savestr, index, arg.index);
(#body //Предварить
(#\. ap (saveD#funcall resstr pos (-#unary tab (#quote -) 1))))))
                                    (#quote else if) (&& (!= ptype "ctype") (<= (#\. this index) (#\. arg index)) (#quote &&) (> (#\. this index) (+ (#\. arg index) (#\. ap index) (#quote +) 1))).
                                    (#body (#return "")))

                                (= ap (#\. ap postop))
                            )
                        )
                    )
                    #else.
                    (#body (#foreach . arg (~ post (#ord (#? (is postop null) [] (#quote :) ([] postop))))).
                        (#body
                            (#if (== (#\. arg index) (-#unary 1)).
                                (#body
                                    (#if (== (#\. arg operator) "[]").
                                        (#body
                                            (#\. arg (saveD#funcall resstr pos tab))
                                        )
                                        (#quote else if) (== (#\. arg type) "init").
                                        (#body
                                        )
                                        #else.
                                        (#body
                                            //Предварить
(#\. arg (saveD#funcall resstr pos (-#unary tab (#quote -) 1)))
                                        ))
                                ))
                        )))

                (savePrint#funcall resstr pos (#\. this operator) operator_lexem)

                (#foreach . arg (~ post (#ord (#? (is postop null) [] (#quote :) ([] postop))))).
                (#body
                    (#if (== (#\. arg index) (-#unary 1)).
                        (#body
                            (#if (== (#\. arg type) "init").
                                (#body
                                    (#\. arg (saveD#funcall resstr pos tab))
                                ))
                        ))
                )

                (#if (&& (!is parent null) (>= index 0) (#quote &&) (> (#\. parent arguments (#quote \.) length) index)).
                    (#body
                        (#foreach i arg (#\. parent arguments (#[ index \.\. $))).
                        (#body
                            (= (ap#var auto) (#\. arg postop))
                            (#while (!is ap null)).
                            (#body
                                //writefln("%s -- %s (%s == %s)", this, ap.index, arg.index + ap.index + 1, this.index);
(#if (== (+ (#\. arg index) (#\. ap index) (#quote +) 1) (#\. this index)).
                                    (#body
                                        (#if (== (#\. ap operator) "[]").
                                            (#body
                                                (#foreach i3 arg3 (#\. parent arguments (#[ (+ index 1) \.\. (+ (#\. arg index) 1)))).
                                                (#body
                                                    (savePrint#funcall resstr pos "," pos)
                                                    (#\. arg3 (saveD#funcall resstr pos (-#unary tab (#quote -) 1) null "ctype"))
                                                )
                                            )
                                            (#quote else if) (== (#\. ap type) "init").
                                            (#body
                                            )
                                            #else.
                                            (#body
                                                (#foreach i3 arg3 (#\. parent arguments (#[ (+ index 1) \.\. (+ (#\. arg index) 1)))).
                                                (#body
                                                    (savePrint#funcall resstr pos "," pos)
                                                    (#\. arg3 (saveD#funcall resstr pos (-#unary tab (#quote -) 1) null "ctype"))
                                                )
                                            ))
                                    )
                                    (#quote else if) (&& (!= ptype "ctype") (<= (#\. this index) (#\. arg index)) (#quote &&) (> (#\. this index) (+ (#\. arg index) (#\. ap index) (#quote +) 1))).
                                    (#body (#return "")))

                                (= ap (#\. ap postop))
                            )
                        )
                    ))

                (#if (!#unary negtab).
                    (#body
                        (savePrint#funcall resstr pos ";" pos)
                    ))
                #break

                (#case "enum")
                (savePrint#funcall resstr pos (#\. this operator) operator_lexem)
                (#foreach i arg (~ post (#ord (#? (is postop null) [] (#quote :) ([] postop))))).
                (#body
                    (#\. arg (saveD#funcall resstr pos tab))
                )
                #break

                (#case "var")
                (#if (== (#\. this type) ".").
                    (#body (= handled false))
                    #else.
                    (#body
                        (#if (> (#\. open_lexem start (#quote \.) row) 0).
                            (#body (savePrint#funcall resstr pos "(" open_lexem)))

                        (#if (!#unary (#\. this arguments (#quote \.) empty)).
                            (#body (#\. this arguments (#[ 0) (#quote \.) (saveD#funcall resstr pos (-#unary tab (#quote -) 1)))))

                        (savePrint#funcall resstr pos (#\. this operator) operator_lexem)

                        (#if (!is postop null).
                            (#body
                                (#\. postop (saveD#funcall resstr pos tab null (#\. this type)))
                            ))

                        (#if (> (#\. close_lexem start (#quote \.) row) 0).
                            (#body (savePrint#funcall resstr pos ")" close_lexem)))
                    ))
                #break

                #default
                (#if (== bt (#\. BlockType File)).
                    (#body
                        (= (#\. pos row) 1)
                        (#foreach i arg (#\. this arguments)).
                        (#body
                            (#\. arg (saveD#funcall resstr pos tab null (#\. this type)))
                        )
                    )
                    #else.(#body (= handled false)))
                #break
            )

            (#if (!#unary handled).
                (#body
                    (. a#var b#var c#var).([]#type long)
                    (#foreach i arg (#\. this arguments)).
                    (#body
                        (#if (&& (!is (#\. arg postop) null) (< (#\. arg postop (#quote \.) index) (-#unary 1))).
                            (#body
                                (~= a (+ i (#\. arg postop (#quote \.) index) (#quote +) 1))
                                (~= b i)
                                (~= c 0)
                            ))
                    )

                    (getPost#function ([]#type Expression) (i long)).
                    (#body
                        (e#var ([]#type Expression))

                        (#foreach j f a).
                        (#body
                            (#if (&& (>= i f) (< i (#\. b (#[ j)))).
                                (#body (~= e (#\. this arguments (#[ (#\. b (#[ j))) (#quote \.) postop))))
                        )

                        (#return e)
                    )

                    (#if (== bt (#\. BlockType Comment)).
                        (#body
                            (savePrint#funcall resstr pos (#\. this operator) operator_lexem)
                            (= (comment#var string) (#\. this operator))
                            (#while 1).(#body
                                (= (newline#var string) (#\. comment (find#funcall "\n")))
                                (#if (!#unary (#\. newline empty)).
                                    (#body
                                        (++#post (#\. pos row))
                                        (= comment newline)
                                        (#\. comment decodeFront#funcall)
                                    )
                                    #else.
                                    (#body
                                        (= (#\. pos col) (#cast uint (#\. comment walkLength#funcall)))
                                        #break
                                    ))
                            )
                        )
                        #else.(#body (#switch (#\. this type)).
                            (#body
                                (#case "module")
                                (savePrint#funcall resstr pos "module " type_lexem)
                                (savePrint#funcall resstr pos (#\. this operator) operator_lexem)
                                (savePrint#funcall resstr pos ";" pos)

                                (#foreach i arg (#\. this arguments)).
                                (#body
                                    (#\. arg (saveD#funcall resstr pos tab null (#\. this type)))
                                )
                                #break

                                (#case "import")
                                (savePrint#funcall resstr pos "import " type_lexem)
                                (savePrint#funcall resstr pos (#\. this arguments (#[ 0) (#quote \.) operator) (#\. this arguments (#[ 0) (#quote \.) operator_lexem))

                                (#if (!#unary (#\. arguments (#[ 0) (#quote \.) arguments (#quote \.) empty)).
                                    (#body
                                        (= (args#var auto) (#\. arguments (#[ 0) (#quote \.) arguments))
                                        (= (farg#var auto) (#\. args (#[ 0)))
                                        (#if (&& (== (#\. farg type) "quote") (> (#\. farg arguments (#quote \.) length) 0) (#quote &&) (== (#\. farg arguments (#[ 0) (#quote \.) operator) ":")).
                                            (#body
                                                (savePrint#funcall resstr pos (#\. farg arguments (#[ 0) (#quote \.) operator) (#\. farg arguments (#[ 0) (#quote \.) operator_lexem))
                                                (= args (#\. args (#[ 1 \.\. $)))
                                            )
                                            #else.
                                            (#body
                                                (savePrint#funcall resstr pos ":" pos)
                                            ))

                                        (#foreach i arg args).
                                        (#body
                                            (#if (> i 0).
                                                (#body
                                                    (savePrint#funcall resstr pos ", " pos)
                                                ))
                                            (savePrint#funcall resstr pos (#\. arg operator) (#\. arg operator_lexem))
                                            (#if (!is (#\. arg postop) null).
                                                (#body
                                                    (#if (&& (== (#\. arg postop (#quote \.) type) "quote") (> (#\. arg postop (#quote \.) arguments (#quote \.) length) 0) (#quote &&) (== (#\. arg postop (#quote \.) arguments (#[ 0) (#quote \.) operator) "=")).
                                                        (#body
                                                            (savePrint#funcall resstr pos (#\. arg postop (#quote \.) arguments (#[ 0) (#quote \.) operator) (#\. arg postop (#quote \.) arguments (#[ 0) (#quote \.) operator_lexem))
                                                            (= arg (#\. arg postop))
                                                        )
                                                        #else.(#body (savePrint#funcall resstr pos " = " pos)))
                                                    (savePrint#funcall resstr pos (#\. arg postop (#quote \.) operator) (#\. arg postop (#quote \.) operator_lexem))
                                                ))
                                        )
                                    ))
                                (savePrint#funcall resstr pos ";" pos)
                                #break

                                (#case "enum")
                                (savePrint#funcall resstr pos "enum" type_lexem)
                                (savePrint#funcall resstr pos (#\. this operator) operator_lexem)
                                (savePrint#funcall resstr pos "{" open_lexem)
                                (#foreach i arg (#\. this arguments)).
                                (#body
                                    (#\. arg (saveD#funcall resstr pos (+ tab 1) null (#\. this type)))
                                    (#if (< i (- (#\. this arguments (#quote \.) length) 1)).
                                        (#body (savePrint#funcall resstr pos "," pos)))
                                )
                                (savePrint#funcall resstr pos "}" close_lexem)
                                #break

                                (#case "init")
                                (savePrint#funcall resstr pos "=" type_lexem)

                                (#if (> (#\. this arguments (#quote \.) length) 0).
                                    (#body
                                        (#if (> (#\. open_lexem start (#quote \.) row) 0).
                                            (#body (savePrint#funcall resstr pos "(" open_lexem)))
                                        (#foreach i arg (#\. this arguments)).
                                        (#body
                                            (#if (> i 0).
                                                (#body
                                                    (savePrint#funcall resstr pos "," pos)
                                                ))
                                            (#\. arg (saveD#funcall resstr pos (-#unary tab (#quote -) 1) null (#\. this type)))
                                        )
                                        (#if (> (#\. close_lexem start (#quote \.) row) 0).
                                            (#body (savePrint#funcall resstr pos ")" close_lexem)))
                                    ))
                                #break

                                (#case ":")
                                (#foreach i arg (#\. this arguments)).
                                (#body
                                    (#\. arg (saveD#funcall resstr pos (-#unary tab (#quote -) 1) null (#\. this type)))
                                )
                                (savePrint#funcall resstr pos type type_lexem)
                                #break

                                (#case "attr")
                                (#foreach i arg (#\. this arguments)).
                                (#body
                                    (#\. arg (saveD#funcall resstr pos (-#unary tab (#quote -) 1) null (#\. this type)))
                                )

                                (#if (!is postop null).
                                    (#body
                                        (#\. postop (saveD#funcall resstr pos (-#unary tab (#quote -) 1) null (#\. this type)))
                                    ))
                                #break

                                (#case "*")
                                (#foreach i arg (#\. this arguments)).
                                (#body
                                    (#\. arg (saveD#funcall resstr pos (-#unary tab (#quote -) 1) null (#\. this type)))
                                )
                                (savePrint#funcall resstr pos type type_lexem)
                                #break

                                (#case "struct")
                                (savePrint#funcall resstr pos "struct " type_lexem)
                                (savePrint#funcall resstr pos (#\. this operator) operator_lexem)
                                (savePrint#funcall resstr pos "{" open_lexem)
                                (#foreach i arg (#\. this arguments)).
                                (#body
                                    (~= savestr (#\. arg (saveD#funcall resstr pos (+ tab 1) null (#\. this type))))
                                )
                                (savePrint#funcall resstr pos "}" close_lexem)
                                #break

                                (#case "class")
                                (savePrint#funcall resstr pos "class " type_lexem)
                                (savePrint#funcall resstr pos (#\. this operator) operator_lexem)
                                (#if (== (#\. arguments (#[ 0) (#quote \.) type) "superclass").
                                    (#body
                                        (savePrint#funcall resstr pos " :" pos)
                                        (#\. arguments (#[ 0) (#quote \.) (saveD#funcall resstr pos (-#unary tab (#quote -) 1) null (#\. this type)))
                                    ))
                                (savePrint#funcall resstr pos "{" open_lexem)

