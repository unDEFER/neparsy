                                        (#\. postop (saveD#funcall resstr pos tab null (#\. this type)))
                                    ))
                                #break

                                (#case "var")
                                (#if (&& (!is parent null) (>= index 0) (#quote &&) (> (#\. parent arguments (#quote \.) length) index)).
                                    (#body
                                        (#foreach i arg (#\. parent arguments (#[ index \.\. $))).
                                        (#body
                                            (#if (!is (#\. arg postop) null).
                                                (#body
                                                    //writefln("%s -- %s (%s == %s)", this, arg2.app_args, arg.index - arg2.app_args + 1, this.index);
(#if (== (+ (#\. arg index) (#\. arg postop (#quote \.) index) (#quote +) 1) (#\. this index)).
                                                        (#body
                                                            (#if (== (#\. arg postop (#quote \.) operator) "[]").
                                                                (#body
                                                                )
                                                                (#quote else if) (== (#\. arg postop (#quote \.) type) "init").
                                                                (#body
                                                                )
                                                                #else.
                                                                (#body
                                                                    (#\. arg postop (#quote \.) (saveD#funcall resstr pos (-#unary tab (#quote -) 1) null "var"))
                                                                ))
                                                        )
                                                        (#quote else if) (&& (!= ptype "ctype") (<= (#\. this index) (#\. arg index)) (#quote &&) (> (#\. this index) (+ (#\. arg index) (#\. arg postop (#quote \.) index) (#quote +) 1))).
                                                        (#body (#return "")))
                                                ))
                                        )
                                    )
                                    (#quote else if) (!is postop null).
                                    (#body
                                        (#if (== (#\. postop index) (-#unary 1)).
                                            (#body
                                                (#if (== (#\. postop operator) "[]").
                                                    (#body
                                                    )
                                                    (#quote else if) (== (#\. postop type) "init").
                                                    (#body
                                                    )
                                                    #else.
                                                    (#body
                                                        (#\. postop (saveD#funcall resstr pos (-#unary tab (#quote -) 1)))
                                                    ))
                                            ))
                                    ))

                                (#foreach i arg (#\. this arguments)).
                                (#body
                                    (#\. arg (saveD#funcall resstr pos (-#unary tab (#quote -) 1)))
                                )

                                (#if (&& (!is parent null) (>= index 0) (#quote &&) (> (#\. parent arguments (#quote \.) length) index)).
                                    (#body
                                        (#foreach i arg (#\. parent arguments (#[ index \.\. $))).
                                        (#body
                                            (#if (!is (#\. arg postop) null).
                                                (#body
                                                    //writefln("%s -- %s (%s == %s)", this, arg2.app_args, arg.index - arg2.app_args + 1, this.index);
(#if (== (+ (#\. arg index) (#\. arg postop (#quote \.) index) (#quote +) 1) (#\. this index)).
                                                        (#body
                                                            (#if (== (#\. arg postop (#quote \.) operator) "[]").
                                                                (#body
                                                                    (#\. arg postop (#quote \.) (saveD#funcall resstr pos tab))
                                                                )
                                                                (#quote else if) (== (#\. arg postop (#quote \.) type) "init").
                                                                (#body
                                                                )
                                                                #else.
                                                                (#body
                                                                ))
                                                        )
                                                        (#quote else if) (&& (!= ptype "ctype") (<= (#\. this index) (#\. arg index)) (#quote &&) (> (#\. this index) (+ (#\. arg index) (#\. arg postop (#quote \.) index) (#quote +) 1))).
                                                        (#body (#return "")))
                                                ))
                                        )
                                    )
                                    (#quote else if) (!is postop null).
                                    (#body
                                        (#if (== (#\. postop index) (-#unary 1)).
                                            (#body
                                                (#if (== (#\. postop operator) "[]").
                                                    (#body
                                                        (#\. postop (saveD#funcall resstr pos tab))
                                                    )
                                                    (#quote else if) (== (#\. postop type) "init").
                                                    (#body
                                                    )
                                                    #else.
                                                    (#body
                                                    ))
                                            ))
                                    ))

                                (#foreach i arg (~ post (#ord (#? (is postop null) [] (#quote :) ([] postop))))).
                                (#body
                                    (#if (== (#\. arg index) (-#unary 1)).
                                        (#body
                                            (#if (== (#\. arg type) "init").
                                                (#body
                                                    (#\. arg (saveD#funcall resstr pos tab))
                                                ))
                                        ))
                                )

                                (savePrint#funcall resstr pos operator operator_lexem)

