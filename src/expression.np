                                (savePrint#funcall resstr pos "(" open_lexem)
                                (#if (>= (#\. this arguments (#quote \.) length) 2).
                                    (#body
                                        (#\. this arguments (#[ 0) (#quote \.) (saveD#funcall resstr pos (-#unary tab (#quote -) 1) null (#\. this type)))
                                        (savePrint#funcall resstr pos ")" close_lexem)
                                        (#\. this arguments (#[ 1) (#quote \.) (saveD#funcall resstr pos (-#unary tab (#quote -) 1) null (#\. this type)))
