                                    (#body
                                        (#foreach i arg (#\. parent arguments (#[ index \.\. $))).
                                        (#body
                                            (#if (!is (#\. arg postop) null).
                                                (#body
                                                    //writefln("%s -- %s (%s == %s)", this, arg2.app_args, arg.index - arg2.app_args + 1, this.index);
(#if (== (+ (#\. arg index) (#\. arg postop (#quote \.) index) (#quote +) 1) (#\. this index)).
                                                        (#body
                                                            (#if (== (#\. arg postop (#quote \.) operator) "[]").
                                                                (#body
                                                                    (#foreach i3 arg3 (#\. parent arguments (#[ (+ index 1) \.\. (+ (#\. arg index) 1)))).
                                                                    (#body
                                                                        (savePrint#funcall resstr pos ", " pos)
                                                                        (#\. arg3 (saveD#funcall resstr pos (-#unary tab (#quote -) 1) null "ctype"))
                                                                    )
                                                                )
                                                                (#quote else if) (== (#\. arg postop (#quote \.) type) "init").
                                                                (#body
                                                                )
                                                                #else.
                                                                (#body
                                                                    (#foreach i3 arg3 (#\. parent arguments (#[ (+ index 1) \.\. (+ (#\. arg index) 1)))).
                                                                    (#body
                                                                        (savePrint#funcall resstr pos ", " pos)
                                                                        (#\. arg3 (saveD#funcall resstr pos (-#unary tab (#quote -) 1) null "ctype"))
                                                                    )
                                                                ))
                                                        )
                                                        (#quote else if) (&& (!= ptype "ctype") (<= (#\. this index) (#\. arg index)) (#quote &&) (> (#\. this index) (+ (#\. arg index) (#\. arg postop (#quote \.) index) (#quote +) 1))).
                                                        (#body (#return "")))
                                                ))
