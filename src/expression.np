        (fixIndent#function void).
        (#body
            (#if (== type "body").
                (#body
                    (= nl1 1)
                    (= nl2 1)
                )
                (#quote else if) (&& (!is parent null) (#ord (|| (== (#\. parent type) "body") (== (#\. parent type) "module") (#quote ||) (== (#\. parent type) "class") (#quote ||) (== (#\. parent type) "struct") (#quote ||) (== (#\. parent type) "if") (#quote ||) (== (#\. parent type) "switch") (#quote ||) (== (#\. parent type) "enum") (#quote ||) (== (#\. parent bt) (#\. BlockType File))))).
                (#body
                    (#if (== type "module").
                        (#body
                            (= nl1 0)
                            (= nl2 0)
                        )
                        (#quote else if) (|| (== type "class") (== type "struct")).
                        (#body
                            (= nl1 2)
                            (= nl2 1)
                        )
                        (#quote else if) (== type "function").
                        (#body
                            (= nl1 2)
                            (= nl2 0)
                        )
                        (#quote else if) (== type "switch").
                        (#body
