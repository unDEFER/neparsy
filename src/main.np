/**
 * main.d
 */

(main#module@D

    (#import iface)

    (#import (gio\.Application (#quote :) GioApplication.(#quote =).(Application)))
    (#import gio\.FileT)
    (#import gtk\.Application)
    (#import gtk\.ApplicationWindow)
    (#import gtk\.Widget)
    (#import gdk\.Event)
    (#import gdk\.Keymap)
    (#import std\.stdio)
    (#import std\.array)
    (#import std\.string)
    (#import std\.conv)
    (#import (std\.typecons (#quote :) Flag Yes No))
    (#import std\.algorithm\.searching)
    (#import std\.math\.traits)
    (#import std\.math)
    (#import std\.algorithm)
    (#import std\.uni)
    (#import std\.file)
    (#import expression)
    (#import lexer)
    (#import parser)

    (MyWindow#class ApplicationWindow#superclass

        (#attr public).(this#function #constructor (gtkApplicationWindow (#* GtkApplicationWindow)) (ownedRef bool).(#init false)).
        (#body
            (super#funcall gtkApplicationWindow ownedRef)
        )

        (#attr public).(this#function #constructor (application Application)).
        (#body
            (super#funcall application)
            (addEvents#funcall (| (#\. EventMask KEY_PRESS_MASK) (#\. EventMask BUTTON_PRESS_MASK)))
            (addOnKeyPress#funcall (&#unary keyPressCallback))
            (addOnButtonPress#funcall (&#unary buttonPressCallback))
            (addOnScroll#funcall (&#unary scrollCallback))
        )

        (#: protected)
        (keyPressCallback#function bool (event Event) (widget Widget)).
        (#body
            (val#var uint)
            (#\. event (getKeyval#funcall val))
            (= (unicode#var dchar) (#cast dchar (#\. Keymap (keyvalToUnicode#funcall val))))

            (state#var GdkModifierType)
            (#\. event (getState#funcall state))

            (#if (&& (& state (#\. GdkModifierType SHIFT_MASK)) (== val 65361))./*LEFT*/
                (#body
                    //write("S<");
(#\. IFACE moveleft#funcall)
                )
                (#quote else if) (&& (& state (#\. GdkModifierType SHIFT_MASK)) (== val 65363))./*RIGHT*/
                (#body
                    //write("S>");
(#\. IFACE moveright#funcall)
                )
                (#quote else if) (== val 65535).
                (#body
                    //write("Del");
(#\. IFACE del#funcall)
                )
                /*Enter*/(#quote else if) /*Escape*/(|| (== val 65307) (== val 65293)).
                (#body
                    //write('\n');
(#\. IFACE escape#funcall)
                )
                (#quote else if) (== unicode ' ').
                (#body
                    //write(unicode);
(#\. IFACE space#funcall)
                )
                (#quote else if) (& state (#\. GdkModifierType CONTROL_MASK)).
                (#body
                    (#if (== unicode ',').
                        (#body
                            //write("^<");
(#\. IFACE less#funcall)
                        )
                        (#quote else if) (== unicode '.').
                        (#body
                            //write("^>");
(#\. IFACE greater#funcall)
                        )
                        (#quote else if) (== unicode 's').
                        (#body
                            (#\. IFACE save#funcall)
                        )
                        (#quote else if) (== unicode 'd').
                        (#body
                            (#\. IFACE saveD#funcall)
                        )
                        (#quote else if) (== unicode 'f').
                        (#body
                            (#\. IFACE fixIndent#funcall)
                        )
                        (#quote else if) (== unicode 'c').
                        (#body
                            //write('C', unicode);
(#\. IFACE copy#funcall)
                        )
                        (#quote else if) (== unicode 'x').
                        (#body
                            //write('C', unicode);
(#\. IFACE copy#funcall)
                            (#\. IFACE del#funcall)
                        )
                        (#quote else if) (== unicode 'v').
                        (#body
                            //write('C', unicode);
(#\. IFACE insert#funcall)
                        )
                        (#quote else if) (== unicode 'l').
                        (#body
                            //write('C', unicode);
(#\. IFACE toLexer#funcall)
                        )
                        (#quote else if) (== unicode '=').
                        (#body
                            (/= (#\. IFACE sx2) 1\.5)
                            (/= (#\. IFACE sy2) 1\.5)
                            (#\. IFACE redraw#funcall)
                        )
                        (#quote else if) (== unicode '-').
                        (#body
                            (*= (#\. IFACE sx2) 1\.5)
                            (*= (#\. IFACE sy2) 1\.5)
                            (#\. IFACE redraw#funcall)
                        )
                        (#quote else if) (== val 65288).
                        (#body
                            //write("C<-");
(#\. IFACE remove#funcall)
                        )
                        (#quote else if) (== val 65361)./*LEFT*/
                        (#body
                            //write("C<");
(#\. IFACE field_left#funcall)
                        )
                        (#quote else if) (== val 65363)./*RIGHT*/
                        (#body
                            //write("C>");
(#\. IFACE field_right#funcall)
                        )
                        (#quote else if) (== val 65364)./*DOWN*/
                        (#body
                            //write("Cv");
(#\. IFACE field_down#funcall)
                        )
                        (#quote else if) (== val 65362)./*UP*/
                        (#body
                            //write("C^");
(#\. IFACE field_up#funcall)
                        ))
                )
                (#quote else if) (== val 65288).
                (#body
                    //write("<-");
(#\. IFACE backspace#funcall)
                )
                (#quote else if) (== val 65361)./*LEFT*/
                (#body
                    //write("<");
(#\. IFACE left#funcall)
                )
                (#quote else if) (== val 65363)./*RIGHT*/
                (#body
                    //write(">");
(#\. IFACE right#funcall)
                )
                (#quote else if) (== val 65364)./*DOWN*/
                (#body
                    //write("v");
(#\. IFACE down#funcall)
                )
                (#quote else if) (== val 65362)./*UP*/
                (#body
                    //write("^");
(#\. IFACE up#funcall)
                )
                (#quote else if) (== unicode '.').
                (#body
                    //write(unicode);
(#\. IFACE dot#funcall)
                )
                (#quote else if) (== unicode ',').
                (#body
                    //write(unicode);
(#\. IFACE comma#funcall)
                )
                (#quote else if) (|| (isAlphaNum#funcall unicode) (isPunctuation#funcall unicode)).
                (#body
                    //write(unicode);
(#\. IFACE (print#funcall unicode))
                ))

            (#\. IFACE redraw#funcall)

            (#return false)
        )

        (buttonPressCallback#function bool (event Event) (widget Widget)).
        (#body
            (button#var uint)
            (#\. event (getButton#funcall button))
            (. x#var y#var).(double)
            (#\. event (getCoords#funcall x y))

            //writefln("%s. %sx%s", button, x, y);
(#return (#\. IFACE (click#funcall button x y)))
        )

        (scrollCallback#function bool (event Event) (widget Widget)).
        (#body
            (. deltaX#var deltaY#var).(double)
            (#\. event (getScrollDeltas#funcall deltaX deltaY))
            (#return (#\. IFACE (scroll#funcall deltaX deltaY)))
        )
    )

    (IFACE Iface)

    (BranchInfo#struct

        (maxdeep int)
        (maxx real)
        (maxy real)
        (fig Expression)
    )

    (main#function int (args ([]#type string))).
    (#body
        (#if (> (#\. args length) 1).
            (#body
                (#if (|| (== (#\. args (#[ 1)) "-h") (== (#\. args (#[ 1)) "--help")).
                    (#body
                        (writefln#funcall (~ "usage: %s [file1] [file2]... -- for editing files in GUI\n"
                                "   or: %s -c <source> <destination> -- for converting between neparsy/D formats\n"
                                (#quote ~) "where files must have '.np' or '.d' extension") (#\. args (#[ 0)) (#\. args (#[ 0)))
                        (#return 0)
                    )
                    (#quote else if) (&& (== (#\. args (#[ 1)) "-c") (== (#\. args length) 4)).
                    (#body
                        (expr#var Expression)
                        (#if (#\. args (#[ 2) (#quote \.) (endsWith#funcall ".d")).
                            (#body
                                (lex#var Lexer)
                                (= (#\. lex file) (readText#funcall (#\. args (#[ 2))))
                                (= (pars#var Parser) (#new Parser))
                                (= (#\. pars lexer) lex)
                                (= expr (#\. pars parse#funcall))
                                (#\. expr fixParents#funcall)
                            )
                            (#quote else if) (#\. args (#[ 2) (#quote \.) (endsWith#funcall ".np")).
                            (#body
                                (= (mod#var string) (readText#funcall (#\. args (#[ 2))))
                                (= expr (#new (Expression#funcall mod)))

                                (= (imod#var string) (readText#funcall (~ (#\. args (#[ 2) (#[ 0 \.\. (- $ 3))) ".inp")))
                                (= (iexpr#var Expression) (#new (Expression#funcall imod)))
                                (#\. expr (merge_inp#funcall iexpr))
                            )
                            #else.
                            (#body
                                (writefln#funcall "Can't convert file with unknown extension: `%s`" (#\. args (#[ 2)))
                                (#return 1)
                            ))

                        (savestr#var string)

                        (#if (#\. args (#[ 3) (#quote \.) (endsWith#funcall ".d")).
                            (#body
                                (= savestr (#\. expr saveD))
                            )
                            (#quote else if) (#\. args (#[ 3) (#quote \.) (endsWith#funcall ".np")).
                            (#body
                                (= savestr (#\. expr save))
                                (= (inp#var string) (#\. expr (save#funcall true)))

                                (= (file#var auto) (File#funcall (~ (#\. args (#[ 3) (#[ 0 \.\. (- $ 3))) ".inp") "w"))
                                (#\. file (writeln#funcall inp))
                            )
                            #else.
                            (#body
                                (writefln#funcall "Can't convert to file with unknown extension: `%s`" (#\. args (#[ 3)))
                                (#return 1)
                            ))

                        (= (file#var auto) (File#funcall (#\. args (#[ 3)) "w"))
                        (#\. file (writeln#funcall savestr))
                        (#return 0)
                    ))
            ))

        (application#var Application)

        (activateClock#function void (app GioApplication)).
        (#body
            (= (win#var MyWindow) (#new (MyWindow#funcall application)))

            (#\. win (setTitle#funcall "Neparsy"))
            (#\. win (setDefaultSize#funcall 640 480))

            (= (x#var real) 0\.0)
            (= (y#var real) 0\.0)

            (= (state#var int) 0)
            (branches#var ([]#type BranchInfo))

            (= (root#var Expression) (#new Expression#funcall))
            (= (#\. root type) "root")

            (#foreach i arg (#\. args (#[ 1 \.\. $))).
            (#body
                (#if (#\. arg (endsWith#funcall ".d")).
                    (#body
                        (lex#var Lexer)
                        (= (#\. lex file) (readText#funcall arg))
                        (= (pars#var Parser) (#new Parser))
                        (= (#\. pars lexer) lex)
                        (= (expr#var Expression) (#\. pars parse#funcall))
                        (#\. expr fixParents#funcall)

                        (= (#\. expr parent) root)
                        (= (#\. expr operator) (~ (#\. arg (#[ 0 \.\. (- $ 2))) ".np"))
                        (= (#\. expr type) "*")
                        (= (#\. expr index) (#\. root arguments (#quote \.) length))
                        (~= (#\. root arguments) expr)
                    )
                    (#quote else if) (#\. arg (endsWith#funcall ".np")).
                    (#body
                        (= (mod#var string) (readText#funcall arg))
                        (= (expr#var Expression) (#new (Expression#funcall mod)))
                        (= (#\. expr parent) root)
                        (= (#\. expr operator) arg)
                        (= (#\. expr index) i)
                        (~= (#\. root arguments) expr)
                    )
                    #else.
                    (#body
                        (writefln#funcall "Skip file with unknown extension: `%s`" arg)
                    ))
            )

            (= IFACE (#new (Iface#funcall root)))
            (#\. win (add#funcall IFACE))
            (#\. IFACE show#funcall)
            (#\. win showAll#funcall)
        )

        (handleOpen#function void (files ([]#type FileIF)) (name string) (app GioApplication)).
        (#body
            (activateClock#funcall app)
        )

        (= application (#new (Application#funcall "org.gtkd.demo.cairo.iface" (#\. GApplicationFlags HANDLES_OPEN))))
        (#\. application (addOnOpen#funcall (&#unary handleOpen)))
        (#\. application (addOnActivate#funcall (&#unary activateClock)))
        (#return (#\. application (run#funcall args)))
    ))
