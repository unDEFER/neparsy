                    (#if (|| (== lexer "++")
                            (== lexer "--")).
                        (#body
                            (= (#\. ed type) "post")
                            getLexem
                            (#goto Operator)
                        ))

                    (#goto Argument)
                )
                (#quote else if) (== lexer "(").
                (#body
                    (#\. ed arguments (#[ (#ord (- $ 1))) (#quote \.) (addChilds#funcall getCallArgs))
                    getLexem
                    (#goto Operator)
                )
                (#quote else if) (== lexer "[").
                (#body
                    (= (slice#var Expression) (#new Expression))
                    (= (#\. slice type_lexem) (#\. lexer lexem))
                    (= (#\. slice open_lexem) (#\. lexer lexem))
                    (= (#\. slice type) "[")
                    (= (s1#var Expression) getExpression)

                    (#if s1.
                        (#body
                            (#\. slice (addChild#funcall s1))
                        ))

                    (#if (== lexer "..").
                        (#body
                            (= (ss#var Expression) (#new Expression))
                            (= (#\. ss operator_lexem) (#\. lexer lexem))
                            (= (#\. ss operator) "..")
                            (= (s2#var Expression) getExpression)
                            (#\. slice (addChild#funcall ss))
                            (#\. slice (addChild#funcall s2))
                        ))

                    (#if (== lexer "]").
                        (#body
                            (#label LookOp2)
                            (= (op#var Lexem) (#\. ed operator_lexem))
                            (= (#\. slice close_lexem) (#\. lexer lexem))

                            (#if (#\. op text (#quote \.) empty).
                                (#body
                                    (= op (#\. ed type_lexem))
                                ))

                            (#if (#\. ed hidden).
                                (#body
                                    (= (#\. op text) "P")
                                ))

                            (#if (#\. op text (#quote \.) empty).
                                (#body
                                    (= (#\. ed type) ".")
                                    (#\. ed (addChild#funcall slice))
                                )
                                (#quote else if) (== (#\. op text) ".").
                                (#body
                                    (#\. ed (addChild#funcall slice))
                                )
                                (#quote else if) (>= (getPriority#funcall ".") (getPriority#funcall (#\. op text))).
                                (#body
                                    (= (expr#var Expression) (#new Expression))
                                    (= (#\. expr type) ".")
                                    (= (ch#var Expression) (#\. ed popChild))
                                    (#\. expr (addChild#funcall ch))
                                    (#\. expr (addChild#funcall slice))
                                    (#\. ed (addChild#funcall expr))
                                    (= ed expr)
                                )
                                (#quote else if) (#\. ed parent).
                                (#body
                                    (= ed (#\. ed parent))
                                    (#goto LookOp2)
                                )
                                #else.
                                (#body
                                    (= (expr#var Expression) (#new Expression))
                                    (= (#\. expr type) ".")

                                    (#if (#\. ed parent).
                                        (#body
                                            (#\. ed parent (#quote \.) (addChild#funcall expr))
                                        )
                                        #else.
                                        (#body
                                            (+= (#\. expr nl1) (#\. ret nl1))
                                            (= (#\. ret nl1) 0)
                                            (= ret expr)
                                        ))
                                    (#\. expr (addChild#funcall ed))
                                    (#\. expr (addChild#funcall slice))
                                    (= ed expr)
                                ))
                            getLexem
                            (#goto Operator)
                        )
                        #else.
                        (#body
                            (writefln#funcall "] Expected not %s" lexer)
                            (assert#funcall 0)
