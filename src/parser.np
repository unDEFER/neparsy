(parser#module@D
    (#import std\.stdio)
    (#import std\.range)
    (#import std\.utf)
    (#import std\.uni)
    (#import std\.algorithm\.searching)
    (#import lexer)
    (#import expression)

    (Parser#class
        (lexer Lexer)

        (getLexem#function void).
        (#body
            (#if backed.
                (#body
                    (= backed false)
                    #return
                ))

            (#\. lexer getLexem#funcall)
        )

        (parse#function Expression).
        (#body
            (= (file#var Expression) (#new Expression))
            (= (#\. file bt) (#\. BlockType File))
            (= (ret#var Expression) (#new Expression))
            (#label Init)
            getLexem

            (#if (== lexer "module").
                (#body
                    (= (#\. ret type) "module")
                    (= (#\. ret type_lexem) (#\. lexer lexem))
                    (= (#\. ret operator_lexem) getModuleName)
                    (= (#\. ret operator) (#\. ret operator_lexem (#quote \.) text))
                    (= (#\. ret label) "D")
                    (~= (#\. file arguments) ret)
                    (#goto Init)
                )
                (#quote else if) (== lexer "import").
                (#body
                    (~= (#\. ret arguments) getImport)
                    (#goto Init)
                )
                (#quote else if) (== lexer "struct").
                (#body
                    (~= (#\. ret arguments) getStruct)
                    (#goto Init)
                )
                (#quote else if) (== lexer "class").
                (#body
                    (~= (#\. ret arguments) getClass)
                    (#goto Init)
                )
                (#quote else if) (== lexer "enum").
                (#body
                    (~= (#\. ret arguments) getEnum)
                    (#goto Init)
                )
                (#quote else if) (== lexer (#\. LexemType Identifier)).
                (#body
                    (~= (#\. ret arguments) getVar)
                    (#goto Init)
                )
                (#quote else if) (== lexer (#\. LexemType EndInput)).
                (#body
                )
                #else.
                (#body
                    (writefln#funcall "Unexpected %s" lexer)
                    (assert#funcall 0)
                ))
            (#return file)
        )

        (getModuleName#function Lexem).
        (#body
            getLexem

            (#if (== lexer (#\. LexemType Identifier)).
                (#body
                    (= (ret#var Lexem) (#\. lexer lexem))
                    getLexem

                    (#if (== lexer ";").
                        (#body
                            (#return ret)
                        )
                        #else.
                        (#body
                            (writefln#funcall "Expected ; after module name not %s" lexer)
                            (assert#funcall 0)
                        ))
                )
                #else.
                (#body
                    (writefln#funcall "Expected LexemType.Identifier after module, not %s" lexer)
                    (assert#funcall 0)
                ))
        )

        (getImport#function Expression).
        (#body
            (= (ret#var Expression) (#new Expression))
            (= (#\. ret type) "import")
            (= (#\. ret type_lexem) (#\. lexer lexem))
            (modname#var Lexem)
            (#label Init)
            getLexem

            (#if (== lexer (#\. LexemType Identifier)).
                (#body
                    (#if (is (#\. modname text) null).
                        (#body
                            (= modname (#\. lexer lexem))
                        )
                        #else.
                        (#body
                            (~= (#\. modname text) (#\. lexer lexem (#quote \.) text))
                            (= (#\. modname end) (#\. lexer lexem (#quote \.) end))
                        ))
                )
                #else.
                (#body
                    (writefln#funcall "Expected identifier not %s" lexer)
                    (assert#funcall 0)
                ))
            getLexem

            (#if (== lexer ".").
                (#body
                    (~= (#\. modname text) ".")
                    (#goto Init)
                )
                (#quote else if) (== lexer ":").
                (#body
                    (= (mod#var Expression) (#new Expression))
                    (= (#\. mod operator_lexem) modname)
                    (= (#\. mod operator) (#\. mod operator_lexem (#quote \.) text))
                    (~= (#\. ret arguments) mod)

                    (= (cexpr#var Expression) (#new Expression))
                    (= (#\. cexpr operator_lexem) (#\. lexer lexem))
                    (= (#\. cexpr operator) (#\. cexpr operator_lexem (#quote \.) text))

                    (= (qexpr#var Expression) (#new Expression))
                    (= (#\. qexpr type) "quote")
                    (#\. qexpr (addChilds#funcall ([] cexpr)))

                    (#\. mod (addChilds#funcall ([] qexpr)))

                    (#label Ident)
                    getLexem

                    (#if (== lexer (#\. LexemType Identifier)).
                        (#body
                            (= (name#var Expression) (#new Expression))
                            (= (#\. name operator_lexem) (#\. lexer lexem))
                            (= (#\. name operator) (#\. name operator_lexem (#quote \.) text))
                            (~= (#\. mod arguments) name)
                            getLexem

                            (#if (== lexer "=").
                                (#body
                                    (= (eexpr#var Expression) (#new Expression))
                                    (= (#\. eexpr operator_lexem) (#\. lexer lexem))
                                    (= (#\. eexpr operator) (#\. eexpr operator_lexem (#quote \.) text))

                                    (= (qeexpr#var Expression) (#new Expression))
                                    (= (#\. qeexpr type) "quote")
                                    (#\. qeexpr (addChilds#funcall ([] eexpr)))

                                    getLexem

                                    (#if (== lexer (#\. LexemType Identifier)).
                                        (#body
                                            (= (rename#var Expression) (#new Expression))
                                            (= (#\. rename operator_lexem) (#\. lexer lexem))
                                            (= (#\. rename operator) (#\. rename operator_lexem (#quote \.) text))
                                            (= (#\. qeexpr postop) rename)
                                            (= (#\. name postop) qeexpr)
                                            getLexem

                                            (#if (== lexer ",").
                                                (#body
                                                    (#goto Ident)
                                                )
                                                (#quote else if) (== lexer ";").
                                                (#body
                                                    (#return ret)
                                                )
                                                #else.
                                                (#body
                                                    (writefln#funcall ", or ; Expected not %s" lexer)
                                                    (assert#funcall 0)
                                                ))
                                        )
                                        #else.
                                        (#body
                                            (writefln#funcall "Expected identifier not %s" lexer)
                                            (assert#funcall 0)
                                        ))
                                )
                                (#quote else if) (== lexer ",").
                                (#body
                                    (#goto Ident)
                                )
                                (#quote else if) (== lexer ";").
                                (#body
                                    (#return ret)
                                )
                                #else.
                                (#body
                                    (writefln#funcall ", or ; or () Expected not %s" lexer)
                                    (assert#funcall 0)
                                ))
                        )
                        #else.
                        (#body
                            (writefln#funcall "Expected identifier not %s" lexer)
                            (assert#funcall 0)
                        ))
                )
                (#quote else if) (== lexer ";").
                (#body
                    (= (mod#var Expression) (#new Expression))
                    (= (#\. mod operator_lexem) modname)
                    (= (#\. mod operator) (#\. mod operator_lexem (#quote \.) text))
                    (~= (#\. ret arguments) mod)
                    (#return ret)
                )
                #else.
                (#body
                    (writefln#funcall "Expected . or ; not %s" lexer)
                    (assert#funcall 0)
                ))
        )

        (getStruct#function Expression).
        (#body
            (= (ret#var Expression) (#new Expression))
            (= (#\. ret type) "struct")
            (= (#\. ret type_lexem) (#\. lexer lexem))
            getLexem

            (#if (== lexer (#\. LexemType Identifier)).
                (#body
                    (= (#\. ret operator_lexem) (#\. lexer lexem))
                    (= (#\. ret operator) (#\. ret operator_lexem (#quote \.) text))
                    getLexem
                ))

            (#if (== lexer "{").
                (#body
                    (= (#\. ret open_lexem) (#\. lexer lexem))
                )
                #else.
                (#body
                    (writefln#funcall "{ Expected not %s" lexer)
                    (assert#funcall 0)
                ))

            (= (#\. ret arguments) getDefinitions)
            (= (#\. ret close_lexem) (#\. lexer lexem))
            (#return ret)
        )

        (getClass#function Expression).
        (#body
            (= (ret#var Expression) (#new Expression))
            (= (#\. ret type) "class")
            (= (#\. ret type_lexem) (#\. lexer lexem))
            getLexem

            (#if (== lexer (#\. LexemType Identifier)).
                (#body
                    (= (#\. ret operator_lexem) (#\. lexer lexem))
                    (= (#\. ret operator) (#\. ret operator_lexem (#quote \.) text))
                    getLexem
                )
                #else.
                (#body
                ))

            (#if (== lexer "{").
                (#body
                    (= (#\. ret open_lexem) (#\. lexer lexem))
                )
                (#quote else if) (== lexer ":").
                (#body
                    (= (type_lexem#var Lexem) (#\. lexer lexem))
                    getLexem

                    (#if (== lexer (#\. LexemType Identifier)).
                        (#body
                        )
                        #else.
                        (#body
                            (writefln#funcall "Expected Identifier not %s" lexer)
                            (assert#funcall 0)
                        ))

                    (= (name#var Expression) (#new Expression))
                    (= (#\. name operator_lexem) (#\. lexer lexem))
                    (= (#\. name operator) (#\. name operator_lexem (#quote \.) text))
                    (= (#\. name type) "superclass")
                    (= (#\. name type_lexem) type_lexem)
                    (~= (#\. ret arguments) name)
                    (#label Interface)
                    getLexem

                    (#if (== lexer ",").
                        (#body

                            (#if (== lexer (#\. LexemType Identifier)).
                                (#body
                                )
                                #else.
                                (#body
                                    (writefln#funcall "Expected Identifier not %s" lexer)
                                    (assert#funcall 0)
                                ))
                            (= (iname#var Expression) (#new Expression))
                            (= (#\. iname operator_lexem) (#\. lexer lexem))
                            (= (#\. iname operator) (#\. iname operator_lexem (#quote \.) text))
                            (~= (#\. name arguments) iname)
                            (#goto Interface)
                        )
                        (#quote else if) (== lexer "{").
                        (#body
                            (= (#\. ret open_lexem) (#\. lexer lexem))
                        )
                        #else.
                        (#body
                            (writefln#funcall "Expected { or , not %s" lexer)
                            (assert#funcall 0)
                        ))
                )
                #else.
                (#body
                    (writefln#funcall "{ or : Expected not %s" lexer)
                    (assert#funcall 0)
                ))
            (~= (#\. ret arguments) getDefinitions)
            (= (#\. ret close_lexem) (#\. lexer lexem))
            (#return ret)
        )

        (getDefinitions#function ([]#type Expression)).
        (#body
            (= (ret#var Expression) (#new Expression))
            (#label Init)
            getLexem

            (#if (== lexer "struct").
                (#body
                    (~= (#\. ret arguments) getStruct)
                    (#goto Init)
                )
                (#quote else if) (== lexer "class").
                (#body
                    (~= (#\. ret arguments) getClass)
                    (#goto Init)
                )
                (#quote else if) (== lexer "enum").
                (#body
                    (~= (#\. ret arguments) getEnum)
                    (#goto Init)
                )
                (#quote else if) (== lexer (#\. LexemType Identifier)).
                (#body
                    (~= (#\. ret arguments) getVar)
                    (#goto Init)
                )
                (#quote else if) (== lexer "}").
                (#body
                    (#return (#\. ret arguments))
                )
                #else.
                (#body
                    (writefln#funcall "LexemType.Identifier expected not %s" lexer)
                    (assert#funcall 0)
                ))
        )

        (getEnum#function Expression).
        (#body
            (= (ret#var Expression) (#new Expression))
            (= (#\. ret type) "enum")
            (= (#\. ret type_lexem) (#\. lexer lexem))
            getLexem

            (#if (== lexer (#\. LexemType Identifier)).
                (#body
                    (= (#\. ret operator_lexem) (#\. lexer lexem))
                    (= (#\. ret operator) (#\. ret operator_lexem (#quote \.) text))
                    getLexem
                )
                #else.
                (#body
                ))

            (#if (== lexer "{").
                (#body
                    (= (#\. ret open_lexem) (#\. lexer lexem))
                )
                #else.
                (#body
                    (writefln#funcall "{ Expected not %s" lexer)
                    (assert#funcall 0)
                ))
            (#label Values)
            getLexem

            (#if (== lexer (#\. LexemType Identifier)).
                (#body
                    (= (val#var Expression) (#new Expression))
                    (= (#\. val operator_lexem) (#\. lexer lexem))
                    (= (#\. val operator) (#\. val operator_lexem (#quote \.) text))
                    getLexem

                    (#if (== lexer "=").
                        (#body
                            (= (ilexem#var Lexem) (#\. lexer lexem))
                            getLexem

                            (#if (|| (== lexer (#\. LexemType Character))
                                    (== lexer (#\. LexemType Number))).
                                (#body
                                    (= (einit#var Expression) (#new Expression))
                                    (= (#\. einit operator_lexem) (#\. lexer lexem))
                                    (= (#\. einit operator) (#\. einit operator_lexem (#quote \.) text))

                                    (= (init#var Expression) (#new Expression))
                                    (= (#\. init type) "init")
                                    (= (#\. init type_lexem) ilexem)
                                    (#\. init (addChilds#funcall ([] einit)))
                                    (#if (== lexer (#\. LexemType Character)).
                                        (#body (= (#\. einit bt) (#\. BlockType Character))))
                                    (= (#\. val postop) init)
                                    getLexem
                                )
                                #else.
                                (#body
                                    (writefln#funcall "Number or Character Expected not %s" lexer)
                                    (assert#funcall 0)
                                ))
                        )
                        #else.
                        (#body
                        ))

                    (#if (== lexer ",").
                        (#body
                            (~= (#\. ret arguments) val)
                            (#goto Values)
                        )
                        (#quote else if) (== lexer "}").
                        (#body
                            (= (#\. ret close_lexem) (#\. lexer lexem))
                            (~= (#\. ret arguments) val)
                        )
                        #else.
                        (#body
                            (writefln#funcall ", or } Expected not %s" lexer)
                            (assert#funcall 0)
                        ))
                )
                #else.
                (#body
                    (writefln#funcall "{ Expected not %s" lexer)
                    (assert#funcall 0)
                ))

            (#return ret)
        )

        (getVar#function ([]#type Expression)).
        (#body
            (= (ret#var Expression) (#new Expression))
            (= (type#var Expression) (#new Expression))
            (pp#var ([]#type Expression))

            (#label Init)
            (#if (|| (== lexer "static")
                    (== lexer "override")
                    (#quote ||) (== lexer "public")
                    (#quote ||) (== lexer "private")
                    (#quote ||) (== lexer "package")
                    (#quote ||) (== lexer "protected")).
                (#body
                    (= (post#var Expression) (#new Expression))
                    (= (#\. post operator_lexem) (#\. lexer lexem))
                    (= (#\. post operator) (#\. post operator_lexem (#quote \.) text))
                    (~= pp post)
                    getLexem
                    (#goto Init)
                )
                (#quote else if) (== lexer ":").
                (#body
                    (= (#\. type nl1) (#\. ret nl1))
                    (~= (#\. type arguments) (#\. ret arguments))
                    (= (#\. type type) ":")
                    (= (#\. type type_lexem) (#\. lexer lexem))
                    (~= (#\. type arguments) pp)
                    (= (#\. type postop) null)
                    (#return ([] type))
                )
                (#quote else if) (== lexer "this").
                (#body
                    (= (#\. type type) "constructor")
                    (= (#\. type type_lexem) (#\. lexer lexem))
                )
                (#quote else if) (== lexer (#\. LexemType Identifier)).
                (#body
                    (= (#\. type operator_lexem) (#\. lexer lexem))
                    (= (#\. type operator) (#\. type operator_lexem (#quote \.) text))
                    getLexem
                )
                #else.
                (#body
                    (writefln#funcall "Unexpected %s" lexer)
                    (assert#funcall 0)
                ))

            (#label Var)
            (#if (== lexer (#\. LexemType Identifier)).
                (#body
                    (= (#\. ret operator_lexem) (#\. lexer lexem))
                    (= (#\. ret operator) (#\. ret operator_lexem (#quote \.) text))
                    (~= (#\. ret arguments) type)
                    getLexem
                )
                (#quote else if) (== lexer "*").
                (#body
                    (= (nt#var Expression) (#new Expression))
                    (= (#\. nt operator) "*")
                    (= (#\. nt operator_lexem) (#\. lexer lexem))
                    (= (#\. nt type) "type")
                    (~= (#\. nt arguments) type)
                    (= type nt)
                    getLexem
                    (#goto Var)
                )
                (#quote else if) (== lexer "[").
                (#body
                    (= (nt#var Expression) (#new Expression))
                    (= (#\. nt operator) "[]")
                    (= (#\. nt operator_lexem) (#\. lexer lexem))
                    (= (#\. nt open_lexem) (#\. lexer lexem))
                    (= (#\. nt type) "type")
                    (~= (#\. nt arguments) type)
                    (= type nt)
                    getLexem

                    (#if (== lexer "]").
                        (#body
                            (= (#\. nt operator_lexem (#quote \.) end) (#\. lexer lexem (#quote \.) end))
                            (= (#\. nt close_lexem) (#\. lexer lexem))
                            getLexem
                            (#goto Var)
                        )
                        #else.
                        (#body
                            (writefln#funcall "Unexpected %s" lexer)
                            (assert#funcall 0)
                        ))
                )
                #else.
                (#body
                    (writefln#funcall "Identifier Expected not %s" lexer)
                    (assert#funcall 0)
                ))

            (#label Eq)
            (#if (== lexer "(").
                (#body
                    (= (#\. ret type) "function")
                    (= (#\. ret open_lexem) (#\. lexer lexem))
                    (~= (#\. ret arguments) getArguments)
                    (= (#\. ret close_lexem) (#\. lexer lexem))

                    (#if (== (#\. ret operator) "function").
                        (#body
                            (= (#\. ret operator) "")
                            (= type ret)
                            (= ret (#new Expression))
                            getLexem

                            (#if (== lexer (#\. LexemType Identifier)).
                                (#body
                                    (= (#\. ret operator_lexem) (#\. lexer lexem))
                                    (= (#\. ret operator) (#\. ret operator_lexem (#quote \.) text))
                                    (~= (#\. ret arguments) type)
                                )
                                #else.
                                (#body
                                    (writefln#funcall "Identifier Expected not %s" lexer)
                                    (assert#funcall 0)
                                ))
                            getLexem

                            (#if (== lexer ";").
                                (#body
                                    (#if (!#unary (#\. pp empty)).
                                        (#body
                                            (= (attr#var Expression) (#new Expression))
                                            (= (#\. attr type) "attr")
                                            (= (#\. attr arguments) pp)
                                            (= (#\. attr postop) ret)
                                            (= ret attr)
                                        ))

                                    (#return ([] ret))
                                )
                                #else.
                                (#body
                                    (writefln#funcall "Expected ; not %s" lexer)
                                    (assert#funcall 0)
                                ))
                        ))
                    getLexem

                    (#if (== lexer "{").
                        (#body
                            back
                            (= (#\. ret postop) getBody)
                        )
                        (#quote else if) (== lexer ";").
                        (#body
                        )
                        #else.
                        (#body
                            (writefln#funcall "Expected { or ; not %s" lexer)
                            (assert#funcall 0)
                        ))
                )
                (#quote else if) (== lexer ",").
                (#body
                    (= (expr#var Expression) (#new Expression))
                    (= (#\. ret arguments) null)
                    (~= (#\. expr arguments) ret)
                    (= ret expr)
                    (#label Var2)
                    getLexem

                    (#if (== lexer (#\. LexemType Identifier)).
                        (#body
                            (= (var#var Expression) (#new Expression))
                            (= (#\. var operator_lexem) (#\. lexer lexem))
                            (= (#\. var operator) (#\. var operator_lexem (#quote \.) text))
                            (~= (#\. expr arguments) var)
                        )
                        #else.
                        (#body
                            (writefln#funcall "Identifier Expected not %s" lexer)
                            (assert#funcall 0)
                        ))
                    getLexem

                    (#label Comma)
                    (#if (== lexer ",").
                        (#body
                            (#goto Var2)
                        )
                        (#quote else if) (== lexer "=").
                        (#body
                            (= (init#var Expression) (#new Expression#funcall))
                            (= (#\. init type_lexem) (#\. lexer lexem))
                            (= (#\. init type) "init")
                            (#\. init (addChilds#funcall ([] getExpression)))
                            (= (#\. expr arguments (#[ (#ord (- $ 1))) (#quote \.) postop) init)
                            (#goto Comma)
                        )
                        (#quote else if) (== lexer ";").
                        (#body
                            (= (#\. type index) (#ord (-#unary (#\. ret arguments (#quote \.) length))))
                            (#\. ret arguments (#[ (#ord (- $ 1))) (#quote \.) (addPosts#funcall ([] type)))

                            (#if (!#unary (#\. pp empty)).
                                (#body
                                    (= (attr#var Expression) (#new Expression))
                                    (= (#\. attr type) "attr")
                                    (= (#\. attr arguments) pp)
                                    (= (#\. attr postop) ret)
                                    (#return ([] attr))
                                ))

                            (#return (#\. ret arguments))
                        )
                        #else.
                        (#body
                            (writefln#funcall "() or , or ; Expected not %s" lexer)
                            (assert#funcall 0)
                        ))
                )
                (#quote else if) (== lexer "=").
                (#body
                    (= (init#var Expression) (#new Expression#funcall))
                    (= (#\. init type_lexem) (#\. lexer lexem))
                    (= (#\. init type) "init")
                    (#\. init (addChilds#funcall ([] getExpression)))
                    (= (#\. ret postop) init)
                    (#goto Eq)
                )
                (#quote else if) (== lexer ";").
                (#body
                )
                #else.
                (#body
                    (writefln#funcall "Expected or () or ; or , not %s" lexer)
                    (assert#funcall 0)
                ))

            (#if (!#unary (#\. pp empty)).
                (#body
                    (= (attr#var Expression) (#new Expression))
                    (= (#\. attr type) "attr")
                    (= (#\. attr arguments) pp)
                    (= (#\. attr postop) ret)
                    (= ret attr)
                ))

            (#return ([] ret))
        )

        (getBody#function Expression).
        (#body
            (= (ret#var Expression) (#new Expression))
            (= (#\. ret type) "body")

            (#label Init)
            (= (s#var ([]#type Expression)) getStatement)

            (#if (&& (== (#\. s length) 1) (== (#\. s (#[ 0) (#quote \.) type) "{")).
                (#body
                    (= (#\. ret open_lexem) (#\. s (#[ 0) (#quote \.) type_lexem))
                    (= (#\. ret close_lexem) (#\. s (#[ 0) (#quote \.) close_lexem))
                    (= s (#\. s (#[ 0) (#quote \.) arguments))
                ))

            (~= (#\. ret arguments) s)
            (#return ret)
        )

        (getCaseBody#function Expression).
        (#body
            (= (ret#var Expression) (#new Expression))
            (= (#\. ret type) "body")
            (#label Init)
            (= (s#var ([]#type Expression)) getStatement)

            (#if (&& (== (#\. s length) 1) (== (#\. s (#[ 0) (#quote \.) type) "{")).
                (#body
                    (= (#\. ret type_lexem) (#\. s (#[ 0) (#quote \.) type_lexem))
                    (= (#\. ret close_lexem) (#\. s (#[ 0) (#quote \.) close_lexem))
                    (= s (#\. s (#[ 0) (#quote \.) arguments))
                ))

            (#if (is s null).
                (#body
                    (#return ret)
                ))
            (~= (#\. ret arguments) s)
            (#goto Init)
        )

        (getStatement#function ([]#type Expression)).
        (#body
            (post#var ([]#type Expression))
            (= (back#var Lexer) lexer)
            (#label Attr)
            getLexem

            (#if (== lexer "static").
                (#body
                    (= (s#var Expression) (#new Expression))
                    (= (#\. s operator_lexem) (#\. lexer lexem))
                    (= (#\. s operator) (#\. s operator_lexem (#quote \.) text))
                    (~= post s)
                    (#goto Attr)
                )
                (#quote else if) (== lexer "if").
                (#body
                    (= (expr#var Expression) (#new Expression))
                    (#if (&& (> (#\. post length) 0) (== (#\. post (#[ (- $ 1)) (#quote \.) operator) "static")).
                        (#body
                            (= (#\. expr type_lexem) (#\. post (#[ (- $ 1)) (#quote \.) operator_lexem))
                            (= (#\. expr type) "static-if")
                            (= post (#\. post (#[ 0 \.\. (- $ 1))))
                        )
                        #else.
                        (#body
                            (= (#\. expr type) "if")
                            (= (#\. expr type_lexem) (#\. lexer lexem))
                        ))
                    (#\. expr (addPosts#funcall post))
                    (= (if_open_close#var Expression) expr)
                    (#label Init)
                    getLexem

                    (#if (== lexer "(").
                        (#body
                            (= (#\. if_open_close open_lexem) (#\. lexer lexem))
                            (= (cond#var Expression) getExpression)

                            (#if (== lexer ")").
                                (#body
                                    (= (#\. if_open_close close_lexem) (#\. lexer lexem))
                                )
                                #else.
                                (#body
                                    (writefln#funcall "Expected . not %s" lexer)
                                    (assert#funcall 0)
                                ))
                            (= (#\. cond postop) getBody)
                            (~= (#\. expr arguments) cond)
