        (getPriority#function int (op string)).
        (#body
            (#switch op).(#body
                (#case "..")
                (#{
                    (#return 0)
                )
                (#case ",")
                (#{
                    (#return 1)
                )
                (#case "=>")
                (#{
                    (#return 2)
                )
                (#case "=")
                (#case "^^=")
                (#case "*=")
                (#case "/=")
                (#case "%=")
                (#case "+=")
                (#case "-=")
                (#case "~=")
                (#case "<<=")
                (#case ">>=")
                (#case ">>>=")
                (#case "&=")
                (#case "|=")
                (#case "^=")
                (#{
                    (#return 3)
                )
                (#case "?")
                (#case ":")
                (#{
                    (#return 4)
                )
                (#case "||")
                (#{
                    (#return 5)
                )
                (#case "&&")
                (#{
                    (#return 6)
                )
                (#case "|")
                (#{
                    (#return 7)
                )
                (#case "^")
                (#{
                    (#return 8)
                )
                (#case "&")
                (#{
                    (#return 9)
