                (#quote else if



                ) (|| (== lexer ",") (== lexer "..") (#quote ||) (== lexer ")") (#quote ||) (== lexer "]") (#quote ||) (== lexer ";")).
                (#body
                    (#if (&& (#ord (is (#\. ret operator) null)) (#ord (is (#\. ret type) null))).
                        (#body
                            (+= (#\. ret arguments (#[ 0) (#quote \.) nl1) (#\. ret nl1))
                            (= ret (#\. ret arguments (#[ 0)))
                        ))
                    (#return ret)
                )
                #else.
                (#body
                    (writefln#funcall "Unexpected %s" lexer)
                    (assert#funcall 0)
                ))
        )

        (getCaseVal#function Expression).
        (#body
            (= (ret#var Expression) (#new Expression))
            (= (ed#var Expression) ret)
            (#label Argument)
            getLexem

            (#if (|| (== lexer (#\. LexemType String))
                    (== lexer (#\. LexemType Number))
                    (#quote ||) (== lexer (#\. LexemType Character))
                    (#quote ||) (== lexer (#\. LexemType Identifier))).
