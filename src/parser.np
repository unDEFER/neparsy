                            (#if (|| (== (#\. op2 text) "?")
                                    (== (#\. op2 text) ":")
                                    (#quote ||) (== (#\. op2 text) ".")).
                                (#body
                                    (= (#\. expr type_lexem) op2)
                                    (= (#\. expr type) (#\. expr type_lexem (#quote \.) text))
                                )
                                #else.
                                (#body
                                    (= (#\. expr operator_lexem) op2)
                                    (= (#\. expr operator) (#\. expr operator_lexem (#quote \.) text))
                                ))
                            (= ret expr)
                            (#\. expr (addChild#funcall ed))
                            (= ed expr)
