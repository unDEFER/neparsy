                (#case "==")
                (#case "!=")
                (#case ">")
                (#case "<")
                (#case ">=")
                (#case "<=")
                (#case "in")
                (#case "!in")
                (#case "is")
                (#case "!is")
                (#{
                    (#return 10)
                )
                (#case "<<")
                (#case ">>")
                (#case ">>>")
                (#{
                    (#return 11)
