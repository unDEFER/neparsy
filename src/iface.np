/**
 * iface.d
 */

(iface#module@D

    (#import std\.stdio)
    (#import std\.math)
    (#import std\.datetime)
    (#import std\.algorithm\.searching)
    (#import std\.algorithm\.mutation)
    (#import std\.range\.primitives)
    (#import std\.utf)
    (#import std\.algorithm)
    (#import (std\.range (#quote :) repeat))
    (#import std\.array)
    (#import std\.conv)

    (#import glib\.Timeout)

    (#import cairo\.Context)
    (#import cairo\.Surface)
    (#import pango\.PgFontDescription)
    (#import pango\.PgLayout)
    (#import pango\.PgCairo)
    (#import pango\.PgCairoFontMap)

    (#import gtk\.Widget)
    (#import gtk\.DrawingArea)
    (#import gdk\.Event)
    (#import gdk\.Window)
    (#import gdk\.Cairo)

    (#import expression)

    (Color#struct

        (. r g b a).(real)
        (invert#function Color).
        (#body
            (= (ret#var auto) (Color#funcall (- (+ 1\.0 (* 0\.402 r)) (* 1\.174 g) (#quote -) (* 0\.228 b))
                    (- 1\.0 (* 0\.598 r) (#quote -) (* 0\.174 g) (#quote -) (* 0\.228 b))
                    (+ (- 1\.0 (* 0\.598 r) (#quote -) (* 1\.174 g)) (* 0\.772 b))
                    a))
            (= (mi#var auto) (min#funcall (#\. ret r) (#\. ret g) (#\. ret b)))
            (= (ma#var auto) (max#funcall (#\. ret r) (#\. ret g) (#\. ret b)))

            (#if (< mi 0).
                (#body
                    (-= (#\. ret r) mi)
                    (-= (#\. ret g) mi)
                    (-= (#\. ret b) mi)
                ))

            (#if (> ma 1\.0).
                (#body
                    (/= (#\. ret r) ma)
                    (/= (#\. ret g) ma)
                    (/= (#\. ret b) ma)
                ))

            (#return ret)
        )

        (#attr static).(hsv#function Color (H real) (S real) (V real) (A real).(#init 1\.0)).
        (#body
            (= (Hi#var byte) (% (#cast byte (#ord (* H 6))) 6))
            (= (Vmin#var real) (* (#ord (- 1\.0 S)) V))
            (= (a#var real) (/ (* (#ord (- V Vmin)) (#ord (% (#ord (* H 360)) 60))) 60))
            (= (Vinc#var real) (+ Vmin a))
            (= (Vdec#var real) (- V a))

            (. R#var G#var B#var).(real)

            (#switch Hi).
            (#body
                (#case 0)
                (= R V)
                (= G Vinc)
                (= B Vmin)
                #break
                (#case 1)
                (= R Vdec)
                (= G V)
                (= B Vmin)
                #break
                (#case 2)
                (= R Vmin)
                (= G V)
                (= B Vinc)
                #break
                (#case 3)
                (= R Vmin)
                (= G Vdec)
                (= B V)
                #break
                (#case 4)
                (= R Vinc)
                (= G Vmin)
                (= B V)
                #break
                (#case 5)
                (= R V)
                (= G Vmin)
                (= B Vdec)
                #break
                #default
                (assert#funcall 0)
            )

            (#return (Color#funcall R G B A))
        )
    )

    (Mode#enum

        Block.(#init 0)
        Circle
    )

    (DrawState#struct

        (. f.(#init 0) t.(#init 360)).(real)
        (. r.(#init 0) d.(#init 0) plus.(#init 30)).(real)
        (post_dir int)
        (mode Mode)
        (. x.(#init 0) y.(#init 0)).(real)
        (line int)
        (. block level).(int)
        (hide bool)
        (llimit int).(#init (-#unary 1))
        (hideline int).(#init (-#unary 1))
        (force bool)
        (sizes_invalid int)

        (blocks (*#type int))
    )

    (RotInfo#struct

        (angle double).(#init 0\.0)
        (target_angle double).(#init 0\.0)
        (fun Expression)
    )

    (Button#struct

        (text string)
        (c Color)
        (type string)
        (expr Expression)
    )

    (typeColor#function Color (type string)).
    (#body
        (= (c#var Color) (Color#funcall 1\.0 1\.0 1\.0 1\.0))

        (#if (== type "module").
            (#body (= c (Color#funcall 1\.0 0\.4 0\.4 1\.0))) // Red
(#quote else if) (== type "class").
            (#body (= c (Color#funcall 1\.0 0\.8 0\.5 1\.0))) // Light Orange
(#quote else if) (== type "struct").
            (#body (= c (Color#funcall 1\.0 0\.6 0\.0 1\.0))) // Saturated Orange
(#quote else if) (== type "enum").
            (#body (= c (Color#funcall 1\.0 1\.0 0\.4 1\.0))) // Yellow
(#quote else if) (== type "function").
            (#body (= c (Color#funcall 0\.4 1\.0 0\.4 1\.0))) // Green
(#quote else if) (== type "var").
            (#body (= c (Color#funcall 0\.4 1\.0 1\.0 1\.0))) // Cyan
(#quote else if) (== type "if").
            (#body (= c (Color#funcall 0\.8 0\.8 1\.0 1\.0))) // Light Blue
(#quote else if) (== type "switch").
            (#body (= c (Color#funcall 0\.4 0\.4 1\.0 1\.0))) // Blue
(#quote else if) (== type "for").
            (#body (= c (Color#funcall 1\.0 0\.6 1\.0 1\.0))) // Light Magenta
(#quote else if) (== type "foreach").
            (#body (= c (Color#funcall 1\.0 0\.1 1\.0 1\.0))) // Saturated Magenta
(#quote else if) (== type "while").
            (#body (= c (Color#funcall 0\.8 0\.1 1\.0 1\.0))) // Saturated Violet
(#quote else if) (== type "do").
            (#body (= c (Color#funcall 0\.9 0\.6 1\.0 1\.0)))) // Light Violet

        (#return c)
    )

    (Iface#class DrawingArea#superclass

        (root_expr Expression)
        (fields Expression)
        (. selected oselected fselected ofunselected).(Expression)
        (scopy Expression)
        (lines ([]#type string))
        (cursor int)
        (. sx1.(#init 0) sy1.(#init 0)).(real)
        (. sx2.(#init 1200) sy2.(#init 900)).(real)
        (. clickX clickY).(real)
        (. clickRX clickRY).(real)
        (scrollY real).(#init 0\.0)
        (click_processed bool).(#init true)
        (edit bool)
        (post_edit bool)

        (#: public)
        (this#function #constructor (_expression Expression)).
        (#body
            (= root_expr _expression)
            (= selected _expression)
            (ri#var RotInfo)
            (= (#\. ri fun) selected)
            (~= rot_info ri)
            //Attach our expose callback, which will draw the window.
(addOnDraw#funcall (&#unary drawCallback))
        )

        (click#function bool (button uint) (x double) (y double)).
        (#body
            (#if (== button 1).
                (#body
                    (#if (|| (!= clickX x) (!= clickY y)).
                        (#body
                            (= clickX x)
                            (= clickY y)
                            (= click_processed false)
                            (= sizes_invalid 2)
                            //writefln("W %sx%s", clickX, clickY);
redraw#funcall
                            (#return true)
                        ))
                ))
            (#return false)
        )

        (scroll#function bool (deltaX double) (deltaY double)).
        (#body
            (+= scrollY (* deltaY 10))
            redraw#funcall
            (#return true)
        )

        (findCircPos#function Expression (expr Expression) (posa int).(#init 1) (root Expression).(#init null)).
        (#body
            (#if (is root null).(#body (= root root_expr)))
            (= (ret#var Expression) root)

            (#foreach . arg (~ (#\. root arguments) (#ord (#? (is (#\. root postop) null) [] (#quote :) ([] (#\. root postop)))))).
            (#body
                //if (arg.hidden && arg.type != "body" && !isNeedHide(arg)) continue;
(= arg (findCircPos#funcall expr posa arg))
                (= (expra#var real) (/ (#ord (+ (#\. expr a1) (#\. expr a2))) 2))
                (= (arga#var real) (/ (#ord (+ (#\. arg a1) (#\. arg a2))) 2))
                (= (reta#var real) (/ (#ord (+ (#\. ret a1) (#\. ret a2))) 2))

                (= (argdiff#var real) (- expra arga))
                (#while (< argdiff (-#unary 180))).(#body (+= argdiff 360))
                (#while (> argdiff 180)).(#body (-= argdiff 360))
                (= (retdiff#var real) (- expra reta))
                (#while (< retdiff (-#unary 180))).(#body (+= retdiff 360))
                (#while (> retdiff 180)).(#body (-= retdiff 360))

                (#static-if false.
                    (#body
                        (#if (&& (> posa 0) (== (#\. arg x) (#\. expr x)) (#quote &&) (== (#\. arg y) (#\. expr y))).
                            (#body
                                (writefln#funcall "%s#%s (%sx%s): %s#%s (%sx%s) => %s#%s (%sx%s)"
                                    (#\. expr operator) (#\. expr type) (#\. expr x) (#\. expr y)
                                    (#\. ret operator) (#\. ret type) (#\. ret x) (#\. ret y)
                                    (#\. arg operator) (#\. arg type) (#\. arg x) (#\. arg y))

                                (#if (!#unary (#\. arg hidden)).
                                    (#body
                                        (writefln#funcall "0")
                                        (#if (#\. ret hidden).
                                            (#body
                                                (writefln#funcall "0/0")
                                            )
                                            (#quote else if) (&& (== (#\. arg x) (#\. expr x)) (== (#\. arg y) (#\. expr y)) (#quote &&) (!#unary (#ord (&& (== (#\. ret x) (#\. expr x)) (== (#\. ret y) (#\. expr y)))))).
                                            (#body
                                                (writefln#funcall "1/1")
                                            )
                                            (#quote else if) (&& (== (#\. arg x) (#\. expr x)) (== (#\. arg y) (#\. expr y))).
                                            (#body
                                                (writefln#funcall "1")
                                                (#if (< (abs#funcall (- (#\. expr r1) (#\. arg r1))) (abs#funcall (- (#\. expr r1) (#\. ret r1)))).
                                                    (#body
                                                        (writefln#funcall "2/2")
                                                    )
                                                    (#quote else if) (== (abs#funcall (- (#\. expr r1) (#\. arg r1))) (abs#funcall (- (#\. expr r1) (#\. ret r1)))).
                                                    (#body
                                                        (writefln#funcall "2")
                                                        (#if (&& (>= retdiff 0) (< argdiff 0)).
                                                            (#body
                                                                (writefln#funcall "3/3")
                                                            )
                                                            (#quote else if) (&& (< argdiff 0) (< retdiff 0) (#quote &&) (>= argdiff retdiff)).
                                                            (#body
                                                                (writefln#funcall "3 final")
                                                            ))
                                                    ))
                                            ))
                                    ))
                            ))
                    ))

                (#if (&& (> posa 0) (#ord
                            (&& (!#unary (#\. arg hidden)) (#ord (|| (#\. ret hidden)
                                        (&& (is (#\. arg center) (#\. expr center)) (!is (#\. ret center) (#\. expr center))) (#quote ||)
                                        (&& (is (#\. arg center) (#\. expr center)) (#ord
                                                (|| (< (abs#funcall (- (#\. expr level) (#\. arg level))) (abs#funcall (- (#\. expr level) (#\. ret level))))
                                                    (&& (== (abs#funcall (- (#\. expr level) (#\. arg level))) (abs#funcall (- (#\. expr level) (#\. ret level)))) (#ord (|| (&& (>= retdiff 0) (< argdiff 0))
                                                                (&& (< argdiff 0) (< retdiff 0) (#quote &&) (>= argdiff retdiff)))))))))))
                        )).
                    (#body
                        (= ret arg)
                    ))

                (#static-if false.
                    (#body
                        (#if (&& (< posa 0) (is (#\. arg center) (#\. expr center))).
                            (#body
                                (writefln#funcall "%s#%s (%sx%s): %s#%s (%sx%s) => %s#%s (%sx%s)"
                                    (#\. expr operator) (#\. expr type) (#\. expr x) (#\. expr y)
                                    (#\. ret operator) (#\. ret type) (#\. ret x) (#\. ret y)
                                    (#\. arg operator) (#\. arg type) (#\. arg x) (#\. arg y))

                                (#if (!#unary (#\. arg hidden)).
                                    (#body
                                        (writefln#funcall "0")
                                        (#if (#\. ret hidden).
                                            (#body
                                                (writefln#funcall "0/0")
                                            )
                                            (#quote else if) (&& (is (#\. arg center) (#\. expr center)) (!is (#\. ret center) (#\. expr center))).
                                            (#body
                                                (writefln#funcall "1/1")
                                            )
                                            (#quote else if) (is (#\. arg center) (#\. expr center)).
                                            (#body
                                                (writefln#funcall "1")
                                                (#if (< (abs#funcall (- (#\. expr level) (#\. arg level))) (abs#funcall (- (#\. expr level) (#\. ret level)))).
                                                    (#body
                                                        (writefln#funcall "2/2")
                                                    )
                                                    (#quote else if) (== (abs#funcall (- (#\. expr level) (#\. arg level))) (abs#funcall (- (#\. expr level) (#\. ret level)))).
                                                    (#body
                                                        (writefln#funcall "2")
                                                        (#if (&& (<= retdiff 0) (> argdiff 0)).
                                                            (#body
                                                                (writefln#funcall "3/3")
                                                            )
                                                            (#quote else if) (&& (> argdiff 0) (> retdiff 0) (#quote &&) (<= argdiff retdiff)).
                                                            (#body
                                                                (writefln#funcall "3 final")
                                                            ))
                                                    ))
                                            ))
                                    ))
                            ))
                    ))

                (#if (&& (< posa 0) (#ord
                            (&& (!#unary (#\. arg hidden)) (#ord (|| (#\. ret hidden)
                                        (&& (is (#\. arg center) (#\. expr center)) (!is (#\. ret center) (#\. expr center))) (#quote ||)
                                        (&& (is (#\. arg center) (#\. expr center)) (#ord
                                                (|| (< (abs#funcall (- (#\. expr level) (#\. arg level))) (abs#funcall (- (#\. expr level) (#\. ret level))))
                                                    (&& (== (abs#funcall (- (#\. expr level) (#\. arg level))) (abs#funcall (- (#\. expr level) (#\. ret level)))) (#ord (|| (&& (<= retdiff 0) (> argdiff 0))
                                                                (&& (> argdiff 0) (> retdiff 0) (#quote &&) (<= argdiff retdiff)))))))))))
                        )).
                    (#body
                        (= ret arg)
                    ))
            )

            (#return ret)
        )

        (findParent#function Expression (expr Expression) (root Expression).(#init null)).
        (#body
            (#if (is root null).(#body (= root expr)))
            (= (ret#var Expression) root)
            (#if (!is (#\. root parent) null).(#body (= ret (#\. root parent))))

            (#if (== (#\. ret type) "body").
                (#body
                    (#if (!is (#\. ret parent) null).(#body (= ret (#\. ret parent)))
                        #else.(#body (= ret root)))
                ))

            (#return ret)
        )

        (findChild#function Expression (expr Expression) (root Expression).(#init null)).
        (#body
            (#if (is root null).(#body (= root expr)))
            (= (ret#var Expression) root)
            (#if (!#unary (#\. root arguments (#quote \.) empty)).(#body (= ret (#\. root arguments (#[ (#\. root focus_index)))))
                (#quote else if) (!is (#\. root postop) null).(#body (= ret (#\. root postop)))
                #else.
                (#body
                    (= (f#var auto) (parentOfFun#funcall root))
                    (#if (&& (!is f null) (!is (#\. f postop) null)).
                        (#body
                            (= ret (#\. f postop))
                        ))
                ))

            (#if (== (#\. ret type) "body").
                (#body
                    (#if (!#unary (#\. ret arguments (#quote \.) empty)).(#body (= ret (#\. ret arguments (#[ (#\. ret focus_index))))))
                ))

            (#return ret)
        )

        (findSibling#function Expression (expr Expression) (dir int) (root Expression).(#init null)).
        (#body
            (#if (is root null).(#body (= root expr)))
            (= (ret#var Expression) root)

            (#if (!is (#\. root parent) null).
                (#body
                    (#if (< (#\. root index) 0).
                        (#body
                            (#if (&& (> dir 0) (> (#\. root arguments (#quote \.) length) 0)).
                                (#body (= ret (#\. root arguments (#[ 0)))))
                        )
                        (#quote else if) (&& (>= (+ (#\. root index) dir) 0) (< (+ (#\. root index) dir) (#\. root parent (#quote \.) arguments (#quote \.) length))).
                        (#body
                            (= ret (#\. root parent (#quote \.) arguments (#[ (+ (#\. root index) dir))))
                        ))
                ))

            (#return ret)
        )

        (updateView#function void).
        (#body
            (= (expr#var auto) selected)
            (= (nr#var double) (- (/ (#ord (+ (#\. expr a1) (#\. expr a2))) 2) 180))
            (#if (< nr 0).(#body (+= nr 360)))

            (ri#var RotInfo)
            (#while (&& (!#unary (#\. rot_info empty)) (>= (#\. rot_info (#[ (- $ 1)) (#quote \.) fun (#quote \.) block) (#\. expr block)))).
            (#body
                (= (#\. ri angle) (#\. rot_info (#[ (- $ 1)) (#quote \.) angle))
                (= rot_info (#\. rot_info (#[ 0 \.\. (- $ 1))))
            )

            (= (#\. ri target_angle) nr)
            //ri.angle = ri.target_angle; // DEBUG

            (= (#\. ri fun) expr)
            (~= rot_info ri)

            (#if (&& (!is (#\. expr parent) null) (>= (#\. expr index) 0)).
                (#body (= (#\. expr parent (#quote \.) focus_index) (#\. expr index))))

            //writefln("Select %s (%s), fsel %s", selected, rot_info.length, fselected);
redraw#funcall
        )

        (updateFields#function void).
        (#body
            (= (sel#var auto) selected)
            (#if (&& (!is (#\. sel parent) null) (== (#\. sel parent (#quote \.) type) ".")).(#body (= sel (#\. sel parent)))
                (#quote else if) (&& (!is (#\. selected parent) null) (>= (#\. selected index) 0)).
                (#body
                    (= (ne#var auto) (#new Expression#funcall))
                    (= (#\. ne type) ".")
                    (= (#\. ne parent) (#\. selected parent))
                    (= (#\. ne index) (#\. selected index))
                    (= (#\. ne x) (#\. selected x))
                    (= (#\. ne y) (#\. selected y))
                    (= (#\. ne r1) (#\. selected r1))
                    (= (#\. ne r2) (#\. selected r2))
                    (= (#\. ne center) (#\. selected center))
                    (= (#\. ne postop) (#\. selected postop))
                    (= (#\. selected postop) null)

                    (#if (!is (#\. ne postop) null).
                        (#body
                            (= (#\. ne postop (#quote \.) parent) ne)
                        ))

                    (= (#\. selected parent (#quote \.) arguments (#[ (#\. selected index))) ne)

                    (= (#\. selected parent) ne)
                    (= (#\. selected index) 0)
                    (= (#\. ne arguments) ([] selected))
                    (= sel ne)
                ))

            (#if (&& (== (#\. sel type) ".") (!#unary (#\. sel arguments (#quote \.) empty))).
                (#body
                    (= (#\. sel arguments) [])
                    (= (fsel#var auto) fselected)
                    #do.
                    (#body
                        (= (ne#var auto) (#new Expression#funcall))
                        (= (#\. ne parent) sel)
                        (= (#\. ne operator) (#\. fsel operator))
                        (= (#\. sel arguments) (~ ne (#\. sel arguments)))
                        (= fsel (#\. fsel parent))
                    ).
                    (#while (!is fsel null))

                    (#foreach i arg (#\. sel arguments)).
                    (#body
                        (= (#\. arg index) i)
                    )

                    (= selected (#\. sel arguments (#[ (- $ 1))))

                    (= (#\. (getFile#funcall selected) type) "*")
                    (= sizes_invalid 1)
                    (getSize#funcall ([] root_expr) (#\. DrawState init))
                    updateView#funcall
                    (= post_edit false)
                ))
        )

        (left#function void).
        (#body
            (#if (is selected null).(#body #return))
            end_edit#funcall
            (= (s#var auto) (findSibling#funcall selected (-#unary 1)))
            (#if (|| (&& (is s selected) (!is (#\. s center) s)) (#\. s hidden)).
                (#body (= selected (findCircPos#funcall selected (-#unary 1))))
                #else.(#body (= selected s)))
            updateView#funcall
        )

        (right#function void).
        (#body
            (#if (is selected null).(#body #return))
            end_edit#funcall
            (= (s#var auto) (findSibling#funcall selected 1))
            (#if (|| (&& (is s selected) (!is (#\. s center) s)) (#\. s hidden)).
                (#body (= selected (findCircPos#funcall selected 1)))
                #else.(#body (= selected s)))
            updateView#funcall
        )

        (up#function void).
        (#body
            (#if (is selected null).(#body #return))
            end_edit#funcall
            (= selected (findParent#funcall selected))
            updateView#funcall
        )

        (down#function void).
        (#body
            (#if (is selected null).(#body #return))
            end_edit#funcall
            (= selected (findChild#funcall selected))
            updateView#funcall
        )

        (field_left#function void).
        (#body
            (#if (is fselected null).(#body #return))
            end_edit#funcall
            (= (s#var auto) (findSibling#funcall fselected (-#unary 1)))
            (#if (&& (is s fselected) (!is (#\. s center) s)).
                (#body (= fselected (findCircPos#funcall fselected (-#unary 1) fields)))
                #else.(#body (= fselected s)))
            updateFields#funcall
        )

        (field_right#function void).
        (#body
            (#if (is fselected null).(#body #return))
            end_edit#funcall
            (= (s#var auto) (findSibling#funcall fselected 1))
            (#if (&& (is s fselected) (!is (#\. s center) s)).
                (#body (= fselected (findCircPos#funcall fselected 1 fields)))
                #else.(#body (= fselected s)))
            updateFields#funcall
        )

        (field_up#function void).
        (#body
            (#if (is fselected null).(#body #return))
            end_edit#funcall
            (= fselected (findParent#funcall fselected))
            updateFields#funcall
        )

        (field_down#function void).
        (#body
            (#if (is fselected null).(#body #return))
            end_edit#funcall
            (= fselected (findChild#funcall fselected))
            updateFields#funcall
        )

        (end_edit#function void).
        (#body
            (#if edit.
                (#body
                    (= edit false)
                    (#if (|| (is (#\. selected parent) null) (!= (#\. selected parent (#quote \.) type) "\"")).
                        (#body
                            (= (s#var auto) (#\. selected operator (#quote \.) (findSplit#funcall "@")))
                            (= (#\. selected operator) (#\. s (#[ 0)))
                            (#if (== (#\. s (#[ 1)) "@").(#body (= (#\. selected label) (#\. s (#[ 2)))))

                            (= s (#\. selected operator (#quote \.) (findSplit#funcall "#")))
                            (= (#\. selected operator) (#\. s (#[ 0)))
                            (#if (== (#\. s (#[ 1)) "#").(#body (= (#\. selected type) (#\. s (#[ 2)))))

                            (= sizes_invalid 1)
                        ))
                ))
        )

        (print#function void (key dchar)).
        (#body
            (#if (is selected null).(#body #return))
            (#if (!#unary edit).
                (#body
                    (#if (== key '@').
                        (#body
                            (#if (!#unary (#\. selected type (#quote \.) empty)).
                                (#body (~= (#\. selected operator) (~ "#" (#\. selected type)))))
                        )
                        #else.(#body (= (#\. selected operator) "")))
                ))

            (~= (#\. selected operator) key)
            (= (#\. (getFile#funcall selected) type) "*")
            (= sizes_invalid 1)
            redraw#funcall
            (= edit true)
            (= post_edit false)
        )

        (backspace#function void).
        (#body
            (#if (is selected null).(#body #return))

            (#if (!#unary (#\. selected operator (#quote \.) empty)).
                (#body (= (#\. selected operator) (#\. selected operator (#[ 0 \.\. (- $ (#\. selected operator (#quote \.) strideBack)))))))
            (= (#\. (getFile#funcall selected) type) "*")
            (= sizes_invalid 1)
            redraw#funcall
            (= edit true)
            (= post_edit false)
        )

        (space#function void).
        (#body
            (#if (is selected null).(#body #return))
            (#if (&& edit (!#unary (#\. selected operator (#quote \.) empty)) (#quote &&) (== (#\. selected operator (#[ 0)) '\"') (#quote &&) (#ord (|| (== (#\. selected operator (#quote \.) length) 1) (!= (#\. selected operator (#[ (- $ 1))) '\"')))).
                (#body
                    (print#funcall ' ')
                    #return
                ))
            end_edit#funcall

            (#if (&& (!is (#\. selected parent) null) (>= (#\. selected index) 0)).
                (#body
                    (= (ne#var auto) (#new Expression#funcall))
                    (= (#\. ne parent) (#\. selected parent))
                    (= (#\. ne index) (+ (#\. selected index) 1))
                    (= (#\. ne x) (#\. selected x))
                    (= (#\. ne y) (#\. selected y))
                    (= (#\. ne r1) (#\. selected r1))
                    (= (#\. ne r2) (#\. selected r2))
                    (= (#\. ne center) (#\. selected center))
                    (#foreach . arg (#\. selected parent (#quote \.) arguments (#[ (+ (#\. selected index) 1) \.\. $))).
                    (#body
                        (++#post (#\. arg index))
                    )
                    (= (#\. selected parent (#quote \.) arguments) (~ (#\. selected parent (#quote \.) arguments (#[ 0 \.\. (+ (#\. selected index) 1))) ne (#quote ~) (#\. selected parent (#quote \.) arguments (#[ (+ (#\. selected index) 1) \.\. $))))
                    (= selected ne)
                ))
            (= (#\. (getFile#funcall selected) type) "*")
            (= sizes_invalid 1)
            (getSize#funcall ([] root_expr) (#\. DrawState init))
            updateView#funcall
            (= post_edit false)
        )

        (dot#function void).
        (#body
            (#if (is selected null).(#body #return))
            (#if edit.
                (#body
                    (print#funcall '.')
                    #return
                ))

