                    (#foreach . ex (#\. expr parent (#quote \.) arguments (#[ 0 \.\. (#\. expr index)))).
                    (#body
                        (#if (&& (== (#\. ex operator) "=") (!#unary (#\. ex arguments (#quote \.) empty)) (#quote &&) (== (#\. ex arguments (#[ 0) (#quote \.) arguments (#quote \.) length) 1)).
                            (#body
                                (~= ret (Button#funcall (#\. ex arguments (#[ 0) (#quote \.) operator) (typeColor#funcall (#\. ex arguments (#[ 0) (#quote \.) type)) (#\. ex arguments (#[ 0) (#quote \.) arguments (#[ 0) (#quote \.) operator) (#\. ex arguments (#[ 0))))
                            )
                            (#quote else if) (&& (== (#\. ex type) "var") (!#unary (#\. ex operator (#quote \.) empty)) (#quote &&) (== (#\. ex arguments (#quote \.) length) 1)).
                            (#body
                                (~= ret (Button#funcall (#\. ex operator) (typeColor#funcall (#\. ex type)) (#\. ex arguments (#[ 0) (#quote \.) operator) ex))
                            ))
                    )
                )
                (#quote else if) (|| (== (#\. expr parent (#quote \.) type) "struct") (== (#\. expr parent (#quote \.) type) "class") (#quote ||) (== (#\. expr parent (#quote \.) type) "root") (#quote ||) (== (#\. expr parent (#quote \.) type) "module") (#quote ||) (== (#\. expr parent (#quote \.) bt) (#\. BlockType File))).
                (#body
                    (#foreach . ex (#\. expr parent (#quote \.) arguments)).
                    (#body
                        (#if (&& (!#unary (#\. ex operator (#quote \.) empty)) (>= (#\. ex arguments (#quote \.) length) 1)).
                            (#body
                                (#if (|| (== (#\. ex type) "struct") (== (#\. ex type) "class") (#quote ||) (== (#\. ex type) "root") (#quote ||) (== (#\. ex type) "module") (#quote ||) (== (#\. ex bt) (#\. BlockType File)) (#quote ||) (== (#\. ex type) "enum")).
                                    (#body (~= ret (Button#funcall (#\. ex operator) (typeColor#funcall (#\. ex type)) (#\. ex type) ex)))
                                    #else.
                                    (#body (~= ret (Button#funcall (#\. ex operator) (typeColor#funcall (#\. ex type)) (#\. ex arguments (#[ 0) (#quote \.) operator) ex))))
                            )
                            (#quote else if) (== (#\. ex type) "import").
                            (#body
                                (= (imp#var auto) (#\. ex arguments (#[ 0) (#quote \.) operator))
                                (#foreach . mod (#\. root_expr arguments)).
                                (#body
                                    (#if (== (#\. mod operator) imp).
                                        (#body
                                            (#foreach . modarg (#\. mod arguments)).
                                            (#body
                                                (#if (&& (!#unary (#\. modarg operator (#quote \.) empty)) (>= (#\. modarg arguments (#quote \.) length) 1)).
                                                    (#body
                                                        (#if (|| (== (#\. modarg type) "struct") (== (#\. modarg type) "class") (#quote ||) (== (#\. modarg type) "root") (#quote ||) (== (#\. modarg type) "module") (#quote ||) (== (#\. modarg bt) (#\. BlockType File)) (#quote ||) (== (#\. modarg type) "enum")).
                                                            (#body (~= ret (Button#funcall (#\. modarg operator) (typeColor#funcall (#\. modarg type)) (#\. modarg type) modarg)))
                                                            #else.
                                                            (#body (~= ret (Button#funcall (#\. modarg operator) (typeColor#funcall (#\. modarg type)) (#\. modarg arguments (#[ 0) (#quote \.) operator) modarg))))
                                                    ))
                                            )

                                            (~= ret (Button#funcall "" (Color#funcall 1\.0 1\.0 1\.0 1\.0) null))
                                        ))
                                )
                            ))
                    )
                )
                (#quote else if) (== (#\. expr parent (#quote \.) type) "function").
                (#body
                    (#if (> (#\. expr parent (#quote \.) arguments (#quote \.) length) 1).
                        (#body (#foreach . ex (#\. expr parent (#quote \.) arguments (#[ 1 \.\. $))).
                            (#body
                                (#if (&& (!#unary (#\. ex operator (#quote \.) empty)) (>= (#\. ex arguments (#quote \.) length) 1)).
                                    (#body (~= ret (Button#funcall (#\. ex operator) (typeColor#funcall (#\. ex type)) (#\. ex arguments (#[ 0) (#quote \.) operator) ex))))
                            )))
                ))

            (#if (!#unary (#\. ret empty)).(#body (= ret (~ ([] (Button#funcall "" (Color#funcall 1\.0 1\.0 1\.0 1\.0) null)) ret))))
            (#return (~ (getSymbols#funcall (#\. expr parent)) ret))
        )

        (getFieldsType#function ([]#type Expression) (type string) (symbols ([]#type Button)) (fsel ([]#type Expression)) (parent Expression) (level int).(#init 1)).
        (#body
            (ret#var ([]#type Expression))
            (#if (&& (> level 2) (#\. fsel empty)).(#body (#return ret)))

            (#foreach . sym.(ref) symbols).
            (#body
                (#if (== type (#\. sym text)).
                    (#body
                        (#if (&& (!is (#\. sym expr) null) (#ord (|| (!= (#\. sym expr (#quote \.) type) "enum") (== level 1)))).
                            (#body
                                (#foreach . arg (#\. sym expr (#quote \.) arguments)).
                                (#body
                                    (= (expr#var Expression) (#new Expression))
                                    (= (#\. expr operator) (#\. arg operator))
                                    (= (#\. expr parent) parent)
                                    (= (#\. expr index) (#\. ret length))

                                    (sel#var bool)
                                    (#if (&& (< level (#\. fsel length)) (== (#\. fsel (#[ level) (#quote \.) operator) (#\. arg operator))).
                                        (#body
                                            (= sel true)
                                            (= fselected expr)
                                        ))

                                    (#if (> (#\. arg arguments (#quote \.) length) 0).
                                        (#body
                                            (= (#\. expr arguments) (getFieldsType#funcall (#\. arg arguments (#[ 0) (#quote \.) operator) symbols (#? sel fsel (#quote :) []) expr (+ level 1)))
                                        ))
                                    (~= ret expr)
                                )
                            ))
                    ))
            )
            //writefln("%s ~ %s", type, ret);

            (#return ret)
        )

        (getFields#function Expression (var string) (symbols ([]#type Button)) (fsel ([]#type Expression))).
        (#body
            (= (expr#var Expression) (#new Expression))
            (= (#\. expr operator) var)

            (= fselected expr)

            (#foreach . sym.(ref) symbols).
            (#body
                (#if (== var (#\. sym text)).
                    (#body
                        (#if (== (#\. sym type) "enum").
                            (#body (= (#\. expr arguments) (getFieldsType#funcall (#\. sym text) symbols fsel expr)))
                            #else.
                            (#body (= (#\. expr arguments) (getFieldsType#funcall (#\. sym type) symbols fsel expr))))
                    ))
            )
            //writefln("%s", expr);

            (#return expr)
        )

        //Override default signal handler:
(drawCallback#function bool (cr (Scoped (#! Context))) (widget Widget)).
        (#body
            // This is where we draw on the window

            (#if (is m_timeout null).
                (#body
                    (#foreach . ri rot_info).
                    (#body
                        (#if (!= (#\. ri target_angle) (#\. ri angle)).
                            (#body
                                //Create a new timeout that will ask the window to be drawn once every second.
(= m_timeout (#new (Timeout#funcall 100 (&#unary onSecondElapsed) false)))
                                #break
                            ))
                    )
                )
                #else.
                (#body
                    (redraw_need#var bool)
                    (#foreach . ri rot_info).
                    (#body
                        (#if (!= (#\. ri target_angle) (#\. ri angle)).
                            (#body
                                (= redraw_need true)
                                #break
                            ))
                    )
                    (#if (!#unary redraw_need).
                        (#body
                            (#\. m_timeout stop#funcall)
                            (= m_timeout null)
                        ))
                ))

            (size#var GtkAllocation)

            (getAllocation#funcall size)

            (rect#var GdkRectangle)
            (= (exist#var bool) (#\. cr (getClipRectangle#funcall rect)))
            (= (sizesInvalid#var int) sizes_invalid)

            (#if (|| (!#unary (#ord (&& (== (#\. rect x) 0) (< (#\. rect width) (#\. size width))))) (> (#\. rect width) (/ (#\. size width) 6))).
                (#body
                    //writefln("Redraw View %sx%s size %sx%s", rect.x, rect.y, rect.width, rect.height);
(= (min_x#var real) (#\. real max))
                    (= (min_y#var real) (#\. real max))
                    (= (max_x#var real) (-#unary (#\. real max)))
                    (= (max_y#var real) (-#unary (#\. real max)))

                    (getSize#funcall ([] root_expr) (#\. DrawState init))
                    (= sizes_invalid 0)

                    (#if (&& (== (#\. rect width) (#\. size width)) (== (#\. rect height) (#\. size height))).
                        (#body (= sizesInvalid 2)))

                    (w#var real)
                    (h#var real)

                    (= min_x sx1)
                    (= min_y sy1)
                    (= max_x sx2)
                    (= max_y sy2)

                    (= w (- max_x min_x))
                    (= h (- max_y min_y))

                    (= (#\. size width) (/ (* (#\. size width) 5) 6))

                    /*if (w/size.width > h/size.height)
            {
                max_y += (w*size.height/size.width - h);
                h = w*size.height/size.width;
                sy2 = h;
            }
            else*/
                    (#{
                        (+= max_x (#ord (- (/ (* h (#\. size width)) (#\. size height)) w)))
                        (= w (/ (* h (#\. size width)) (#\. size height)))
                        (= sx2 w)
                    )

                    (= clickRX (+ (/ (* (#ord (- clickX (/ (#\. size width) 5\.0))) w) (#\. size width)) min_x))
                    (= clickRY (+ (/ (* clickY h) (#\. size height)) min_y))

                    (#\. cr save#funcall)
                    (#\. cr (scale#funcall (/ (#\. size width) w) (/ (#\. size height) h)))
                    (#\. cr (translate#funcall (+ (-#unary min_x) (/ w 5\.0)) (-#unary min_y)))
                    (#\. cr (setLineWidth#funcall m_lineWidth))

                    (#\. cr (rectangle#funcall 0 0 sx2 sy2))
                    (#\. cr clip#funcall)

                    (= (c#var Color) (Color#funcall 0\.9 0\.9 0\.9 1\.0))
                    (#\. cr (setSourceRgba#funcall (#\. c r) (#\. c g) (#\. c b) (#\. c a)))
                    (#\. cr paint#funcall)

                    (= (black#var Color) (Color#funcall 0 0 0\.0 1\.0))
                    (#\. cr (setSourceRgba#funcall (#\. black r) (#\. black g) (#\. black b) (#\. black a)))

                    (ds#var DrawState)
                    (= (#\. ds sizes_invalid) sizesInvalid)

                    (#if (#\. dx empty).
                        (#body (~= dx 150)))

                    (= oforeground foreground)
                    (= foreground [])
                    (drawAll#funcall cr ([] root_expr) ds)
                    (#\. cr restore#funcall)

                    (= (redraw_need#var bool) false)
                    (#foreach . ri.(ref) rot_info).
                    (#body
                        (#if (!= (#\. ri target_angle) (#\. ri angle)).
                            (#body
                                //writefln("target %s rot %s", ri.target_angle, ri.angle);
//writefln("%s + %s", 0.8*target_angle, 0.2*rot_angle);
(= (adiff#var real) (- (#\. ri angle) (#\. ri target_angle)))

                                (#while (> adiff 180)).
                                (#body
                                    (-= (#\. ri angle) 360)
                                    (-= adiff 360)
                                )

                                (#while (< adiff (-#unary 180))).
                                (#body
                                    (+= (#\. ri angle) 360)
                                    (+= adiff 360)
                                )

                                (#if (< (abs#funcall (- (#\. ri target_angle) (#\. ri angle))) 10).
                                    (#body (= (#\. ri angle) (#\. ri target_angle)))
                                    #else.
                                    (#body (= (#\. ri angle) (+ (* 0\.6 (#\. ri target_angle)) (* 0\.4 (#\. ri angle))))))
                                //writefln("=rot %s", ri.angle);

                                (= redraw_need true)
                            ))
                    )

                    (#if (!= (#\. frot_info target_angle) (#\. frot_info angle)).
                        (#body
                            //writefln("target %s rot %s", frot_info.target_angle, frot_info.angle);
//writefln("%s + %s", 0.8*target_angle, 0.2*rot_angle);
(= (adiff#var real) (- (#\. frot_info angle) (#\. frot_info target_angle)))

                            (#while (> adiff 180)).
                            (#body
                                (-= (#\. frot_info angle) 360)
                                (-= adiff 360)
                            )

                            (#while (< adiff (-#unary 180))).
                            (#body
                                (+= (#\. frot_info angle) 360)
                                (+= adiff 360)
                            )

                            (#if (< (abs#funcall (- (#\. frot_info target_angle) (#\. frot_info angle))) 10).
                                (#body (= (#\. frot_info angle) (#\. frot_info target_angle)))
                                #else.
                                (#body (= (#\. frot_info angle) (+ (* 0\.6 (#\. frot_info target_angle)) (* 0\.4 (#\. frot_info angle))))))
                            //writefln("=rot %s", frot_info.angle);

                            (= redraw_need true)
                        ))

                    (#if (< (#\. selected x) 150).
                        (#body
                            (= redraw_need true)
                            (+= (#\. dx (#[ (#\. selected line))) (- 150 (#\. selected x)))
                        )
                        (#quote else if) (> (#\. selected x) (- sx2 150)).
                        (#body
                            (= redraw_need true)
                            (-= (#\. dx (#[ (#\. selected line))) (- (#\. selected x) (#ord (- sx2 150))))
                        ))

                    (#if (< (#\. selected y) 150).
                        (#body
                            (= redraw_need true)
                            (+= dy (- 150 (#\. selected y)))
                        )
                        (#quote else if) (> (#\. selected y) (- sy2 300)).
                        (#body
                            (= redraw_need true)
                            (-= dy (- (#\. selected y) (#ord (- sy2 300))))
                        ))

                    (#if redraw_need.
                        (#body redraw#funcall))
                ))

            (#if (== (#\. rect x) 0).
                (#body
                    //writefln("Redraw Navigation %sx%s size %sx%s", rect.x, rect.y, rect.width, rect.height);
(#\. cr save#funcall)

                    (/= (#\. size width) 5)
                    (= (w#var real) 200)
                    (= (h#var real) (/ (* w (#\. size height)) (#\. size width)))

                    (#\. cr (scale#funcall (/ (#\. size width) w) (/ (#\. size height) h)))
                    (#\. cr (setLineWidth#funcall m_lineWidth))

                    (#\. cr (rectangle#funcall 0 0 w h))
                    (#\. cr clip#funcall)

                    (= (c#var Color) (Color#funcall 0\.9 0\.9 1\.0 1\.0))
                    (#\. cr (setSourceRgba#funcall (#\. c r) (#\. c g) (#\. c b) (#\. c a)))
                    (#\. cr paint#funcall)

                    (= c (Color#funcall 0\.5 0\.5 1\.0 1\.0))
                    (#\. cr (setSourceRgba#funcall (#\. c r) (#\. c g) (#\. c b) (#\. c a)))
                    (#\. cr (moveTo#funcall 100 0))
                    (#\. cr (lineTo#funcall 200 50))
                    (#\. cr (lineTo#funcall 100 100))
                    (#\. cr (lineTo#funcall 0 50))
                    (#\. cr closePath#funcall)
                    (#\. cr fill#funcall)

                    (= c (Color#funcall 1\.0 1\.0 1\.0 1\.0))
                    (#\. cr (setSourceRgba#funcall (#\. c r) (#\. c g) (#\. c b) (#\. c a)))
                    (#\. cr (rectangle#funcall 50 25 100 50))
                    (#\. cr fill#funcall)

                    (= c (Color#funcall 0\.0 0\.0 0\.0 1\.0))
                    (#\. cr (setSourceRgba#funcall (#\. c r) (#\. c g) (#\. c b) (#\. c a)))

                    (#\. cr (rectangle#funcall 50 25 50 25))
                    (#\. cr stroke#funcall)
                    (drawText#funcall cr "." 75 37\.5 50 c)

                    (#\. cr (rectangle#funcall 100 25 50 25))
                    (#\. cr stroke#funcall)
                    (drawText#funcall cr "+" 125 37\.5 50 c)

                    (#\. cr (rectangle#funcall 50 50 50 25))
                    (#\. cr stroke#funcall)
                    (drawText#funcall cr "," 75 62\.5 50 c)

                    (#\. cr (rectangle#funcall 100 50 25 25))
                    (#\. cr stroke#funcall)
                    (drawText#funcall cr "<" 112\.5 62\.5 25 c)

                    (#\. cr (rectangle#funcall 125 50 25 25))
                    (#\. cr stroke#funcall)
                    (drawText#funcall cr ">" 137\.5 62\.5 25 c)

                    (= (y#var real) 125)
                    (= (x#var real) 5)

                    (= c (Color#funcall 1\.0 1\.0 1\.0 1\.0))
                    (#\. cr (setSourceRgba#funcall (#\. c r) (#\. c g) (#\. c b) (#\. c a)))
                    (#\. cr (rectangle#funcall x y 190 20))
                    (#\. cr fill#funcall)

                    (= c (Color#funcall 0\.0 0\.0 0\.0 1\.0))
                    (#\. cr (setSourceRgba#funcall (#\. c r) (#\. c g) (#\. c b) (#\. c a)))
                    (#\. cr (rectangle#funcall x y 190 20))
                    (#\. cr stroke#funcall)
                    (drawText#funcall cr (#\. selected text) (+ x (/ (#ord 190) 2)) (+ y 10) 180 c)

                    (= x 5)
                    (+= y 35)

                    (buttons#var ([]#type Button))
                    (#if (&& (!is (#\. selected parent) null) (#ord (|| (== (#\. selected parent (#quote \.) type) "body") (== (#\. selected parent (#quote \.) type) "root") (#quote ||) (== (#\. selected parent (#quote \.) type) "module") (#quote ||) (== (#\. selected parent (#quote \.) bt) (#\. BlockType File)) (#quote ||) (== (#\. selected parent (#quote \.) type) "struct") (#quote ||) (== (#\. selected parent (#quote \.) type) "class")))).
                        (#body
                            (#foreach . type ([] "import" "class" "struct" "function" "enum" "var")).
                            (#body (~= buttons ([] (Button#funcall (~ "#" type) (typeColor#funcall type) null))))
                        ))

                    (#if (&& (!is (#\. selected parent) null) (== (#\. selected parent (#quote \.) type) "body")).
                        (#body
                            (~= buttons ([] (Button#funcall "" c null)))
                            (#foreach . type ([] "if" "switch" "for" "foreach" "while" "do" "return")).
                            (#body (~= buttons ([] (Button#funcall (~ "#" type) (typeColor#funcall type) null))))
                        ))

                    (symbols#var ([]#type Button)).(static)
                    (sel#var Expression)
                    (fsel#var ([]#type Expression))
                    (#if (|| (> sizesInvalid 0) (!is selected oselected)).
                        (#body
                            (= sel selected)
                            (= fsel ([] selected))
                            (#if (&& (!is (#\. sel parent) null) (== (#\. sel parent (#quote \.) type) ".")).(#body (= sel (#\. sel parent))))
                            (#if (&& (== (#\. sel type) ".") (!#unary (#\. sel arguments (#quote \.) empty))).
                                (#body
                                    (= fsel (#\. sel arguments))
                                    (= sel (#\. sel arguments (#[ 0)))
                                ))

                            (= symbols (getSymbols#funcall sel))
                        ))
                    (~= buttons symbols)

                    (#\. cr (rectangle#funcall 0 y w (- h y)))
                    (#\. cr clip#funcall)
                    (#\. cr (translate#funcall 0 scrollY))
                    (#foreach . but buttons).
                    (#body
                        (#if (#\. but text (#quote \.) empty).
                            (#body
                                (= x 5)
                                (+= y 35)
                                #continue
                            ))

                        (= (wi#var real) (textWidth#funcall (#\. but text)))
                        (#if (> (+ x wi) 200).
                            (#body
                                (= x 5)
                                (+= y 25)
                            ))

                        (= c (#\. but c))
                        (#\. cr (setSourceRgba#funcall (#\. c r) (#\. c g) (#\. c b) (#\. c a)))
                        (#\. cr (rectangle#funcall x y (+ wi 5) 20))
                        (#\. cr fill#funcall)

                        (= c (Color#funcall 0\.0 0\.0 0\.0 1\.0))
                        (#\. cr (setSourceRgba#funcall (#\. c r) (#\. c g) (#\. c b) (#\. c a)))
                        (#\. cr (rectangle#funcall x y (+ wi 5) 20))
                        (#\. cr stroke#funcall)
                        (drawText#funcall cr (#\. but text) (+ x (/ (#ord (+ wi 5)) 2)) (+ y 10) (+ wi 5) c)

                        (+= x (+ wi 10))
                    )

                    (#\. cr restore#funcall)

                    (#if (|| (> sizesInvalid 0) (!is selected oselected)).
                        (#body
                            (= fields (getFields#funcall (#\. sel operator) symbols fsel))
                            (= oselected selected)
                            (= ofunselected (parentOfFun#funcall oselected))

                            (= (ds#var auto) (#\. DrawState init))
                            (= (#\. ds force) true)
                            (getSize#funcall ([] fields) ds)

                            (= (expr#var auto) fselected)
                            (= (nr#var double) (- (/ (#ord (+ (#\. expr a1) (#\. expr a2))) 2) 180))
                            (#if (< nr 0).(#body (+= nr 360)))

                            (= (#\. frot_info target_angle) nr)
                            (= (#\. frot_info fun) expr)
                        ))

                    (#if (!#unary (#\. fields arguments (#quote \.) empty)).
                        (#body
                            (#\. cr save#funcall)

                            (#\. cr (translate#funcall 0 (- (#\. size height) (#\. size width))))
                            (#\. cr (scale#funcall (/ (#\. size width) w) (/ (#\. size height) h)))
                            (#\. cr (scale#funcall (/ 2\.0 3) (/ 2\.0 3)))
                            (#\. cr (setLineWidth#funcall m_lineWidth))

                            (#\. cr (rectangle#funcall 0 0 300 300))
                            (#\. cr clip#funcall)

                            (= c (Color#funcall 0\.9 0\.9 1\.0 1\.0))
                            (#\. cr (setSourceRgba#funcall (#\. c r) (#\. c g) (#\. c b) (#\. c a)))
                            (#\. cr paint#funcall)

                            (= c (Color#funcall 0\.0 0\.0 0\.0 1\.0))
                            (#\. cr (setSourceRgba#funcall (#\. c r) (#\. c g) (#\. c b) (#\. c a)))
                            (#\. cr (rectangle#funcall 0 0 300 300))
                            (#\. cr stroke#funcall)

                            (= (ds#var auto) (#\. DrawState init))
                            (= (#\. ds force) true)
                            (= (#\. ds sizes_invalid) 2)
                            (drawAll#funcall cr ([] fields) ds)

                            (#\. cr restore#funcall)
                        ))
                ))

            /*if (selected.parent !is null)
        writefln("%s#%s %s %s", selected.parent.operator, selected.parent.type,
                selected.parent.r3, (selected.parent.x2-selected.parent.x1)/(2*PI));
                */

            (#return true)
        )

        (onSecondElapsed#function bool).
        (#body
            redraw#funcall
            (#return true)
        )

        (m_radius double).(#init 0\.40)
        (m_lineWidth double).(#init 1\.0)
        (rot_info ([]#type RotInfo))
        (frot_info RotInfo)
        (. foreground oforeground).([]#type Expression)
        (dx ([]#type real))
        (dy real).(#init 0)
        (rlines ([]#type real))
        (sizes_invalid int).(#init 1)

        (m_timeout Timeout)
    ))
